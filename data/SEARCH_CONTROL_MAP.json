  "neighborhood_tree": {
    "_doc": "Neighborhood tree filter. Present in Building search and Advanced search only. Uses parent-child cascade (check borough → auto-check all children). Collected by label text content.",
    "scope": ["building", "advanced"],
    "canonical_key": "neighborhoods",
    "target_field": "MLSAreaMinor",
    "operator": "in_list",
    "cascade_rule": "Checking a borough checkbox auto-checks all child neighborhood checkboxes. Unchecking a borough unchecks all children.",
    "collection": "querySelectorAll('.neighborhood-tree label input[type=\"checkbox\"]:checked') → extract label text"
  },
  "cross_listing_checkboxes": {
    "_doc": "Cross-listing checkboxes (e.g., 'Include Listed for Rent' on sale tab).",
    "sale": [
      { "data_field": "CrossListing", "data_value": "ListedForRent", "label": "Include Listed for Rent", "notes": "Shows sale listings that are also listed for rent." }
    ],
    "rental": [
      { "data_field": "CrossListing", "data_value": "AlsoForSale", "label": "Include Also for Sale", "notes": "Shows rental listings that are also for sale." }
    ]
  },
  "tab_switching": {
    "_doc": "Search tab state management.",
    "state_variable": "currentSearchTab",
    "values": ["sale", "rent", "building"],
    "default": "sale",
    "behavior": "Switching tabs shows/hides the appropriate basic form. Filters are tab-specific — sale uses saleMin*/saleMax*, rental uses rentalMin*/rentalMax*. collectSearchCriteria() reads the correct IDs based on currentSearchTab."
  },
  "clear_form": {
    "_doc": "clearSearchForm() resets all inputs and re-checks default status checkboxes.",
    "actions": [
      "Reset all select elements in sale, rental, and building basic forms to first option",
      "Uncheck all checkboxes",
      "Re-check 'All Active' (sale) and 'All Active' (rental) default checkboxes",
      "Clear all text inputs",
      "Reset currentSearchTab to current tab (don't switch)"
    ]
  },
  "diff_checklist": {
    "_doc": "After every search edit, verify BOTH SEARCH-STANDALONE.html and CRM embedded search have the same:",
    "checks": [
      "All status checkboxes have data-field='MlsStatus' and correct data-value/data-sub-status attributes",
      "All ownership checkboxes have data-field='CommonInterest' and correct data-value",
      "collectSearchCriteria() reads the same IDs with the same parse functions",
      "filterListings()/filterSearchListings() uses the same filter conditions with explicit null/undefined checks",
      "Mock data array has the same shape (all keys present) and same field types",
      "Quick Search inputs have IDs matching this map",
      "clearSearchForm() resets the same defaults",
      "Pagination functions reference total count correctly"
    ]
  }
}
