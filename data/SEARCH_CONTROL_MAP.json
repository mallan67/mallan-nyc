  "quick_search": {
    "_doc": "Quick Search text inputs. 3 forms (sale, rental, building) x 3 inputs each = 9 total. Matched by ID.",
    "sale": [
      { "dom_id": "saleQuickRls", "canonical_key": "rlsId", "target_fields": ["ListingId", "ListingKey"], "operator": "exact_match_csv", "label": "RLS ID, Web ID, Listing #", "notes": "Comma-separated. Checks lid, wid, and id." },
      { "dom_id": "saleQuickZip", "canonical_key": "zip", "target_fields": ["PostalCode"], "operator": "exact_match", "label": "Zip", "notes": "5-digit exact match." },
      { "dom_id": "saleQuickAddress", "canonical_key": "address", "target_fields": ["UnparsedAddress", "BuildingName"], "operator": "partial_match", "label": "Address, Building Name", "notes": "Partial (indexOf), also matches buildingName." },
      { "dom_id": "saleQuickUnit", "canonical_key": "unit", "target_fields": ["UnitNumber"], "operator": "exact_match", "label": "Unit #", "notes": "Optional. Exact match." }
    ],
    "rental": [
      { "dom_id": "rentalQuickRls", "canonical_key": "rlsId", "target_fields": ["ListingId", "ListingKey"], "operator": "exact_match_csv", "label": "RLS ID, Web ID, Listing #", "notes": "Same logic as sale." },
      { "dom_id": "rentalQuickZip", "canonical_key": "zip", "target_fields": ["PostalCode"], "operator": "exact_match", "label": "Zip", "notes": null },
      { "dom_id": "rentalQuickAddress", "canonical_key": "address", "target_fields": ["UnparsedAddress", "BuildingName"], "operator": "partial_match", "label": "Address, Building Name", "notes": null },
      { "dom_id": "rentalQuickUnit", "canonical_key": "unit", "target_fields": ["UnitNumber"], "operator": "exact_match", "label": "Unit #", "notes": null }
    ],
    "building": [
      { "dom_id": "buildingQuickRls", "canonical_key": "rlsId", "target_fields": ["ListingId", "ListingKey"], "operator": "exact_match_csv", "label": "RLS ID, Web ID, Listing #", "notes": null },
      { "dom_id": "buildingQuickZip", "canonical_key": "zip", "target_fields": ["PostalCode"], "operator": "exact_match", "label": "Zip", "notes": null },
      { "dom_id": "buildingQuickAddress", "canonical_key": "address", "target_fields": ["UnparsedAddress", "BuildingName"], "operator": "partial_match", "label": "Address, Building Name", "notes": null },
      { "dom_id": "buildingQuickUnit", "canonical_key": "unit", "target_fields": ["UnitNumber"], "operator": "exact_match", "label": "Unit #", "notes": null }
    ]
