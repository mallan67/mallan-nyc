{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node public/crm/build.js && npx prisma generate && (npx prisma migrate deploy || echo 'Migration skipped — DB cold') && npm run build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    { "path": "/api/cron/data-retention", "schedule": "0 3 * * *" },
    { "path": "/api/cron/dom-reset", "schedule": "0 6 * * *" },
    { "path": "/api/cron/idx-sync", "schedule": "*/12 * * * *" },
    { "path": "/api/cron/listing-expiration", "schedule": "0 7 * * *" },
    { "path": "/api/cron/search-alerts", "schedule": "30 7 * * *" },
    { "path": "/api/cron/seller-scoring", "schedule": "0 8 * * *" },
    { "path": "/api/cron/tenant-nurture", "schedule": "30 8 * * *" },
    { "path": "/api/cron/prospect-triggers", "schedule": "0 9 * * *" },
    { "path": "/api/cron/experiment-metrics", "schedule": "0 9 30 * *" },
    { "path": "/api/cron/demand-signals", "schedule": "0 10 * * *" },
    { "path": "/api/cron/intent-profiles", "schedule": "0 11 * * *" },
    { "path": "/api/cron/agent-metrics", "schedule": "0 12 * * 1" },
    { "path": "/api/cron/lead-scoring", "schedule": "0 13 * * *" },
    { "path": "/api/cron/conviction-scores", "schedule": "0 14 * * *" },
    { "path": "/api/cron/listing-momentum", "schedule": "0 15 * * *" },
    { "path": "/api/cron/social-proof", "schedule": "0 16 * * *" },
    { "path": "/api/cron/market-snapshots", "schedule": "0 6 1 * *" }
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mallan.nyc"
        }
      ],
      "destination": "https://mallan.nyc/:path*",
      "permanent": true
    },
    {
      "source": "/exclusives",
      "destination": "/buy?exclusive=mallan",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/crm/login.html" },
    { "source": "/crm", "destination": "/crm/dashboard.html" },
    { "source": "/crm/dashboard", "destination": "/crm/dashboard.html" },
    { "source": "/crm/login", "destination": "/crm/login.html" },
    { "source": "/crm/search", "destination": "/crm/index-built.html" },
    { "source": "/crm/sale-listing", "destination": "/crm/SALE-FORM-REDESIGN.html" },
    { "source": "/crm/rental-listing", "destination": "/crm/RENTAL-FORM-REDESIGN.html" },
    { "source": "/crm/sale-view", "destination": "/crm/SALE-FORM-WITH-TOOLS.html" },
    { "source": "/crm/rental-view", "destination": "/crm/RENTAL-FORM-WITH-TOOLS.html" },
    { "source": "/crm/buyer-deal", "destination": "/crm/BUYER-DEAL-FORM.html" },
    { "source": "/crm/tenant-deal", "destination": "/crm/TENANT-DEAL-FORM.html" },
    { "source": "/crm/tests/:path*", "destination": "/404" },
    { "source": "/crm/scripts/:path*", "destination": "/404" }
  ]
}
