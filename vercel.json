{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node public/crm/build.js && npx prisma migrate deploy && npm run build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    { "path": "/api/cron/dom-reset", "schedule": "0 6 * * *" },
    { "path": "/api/cron/idx-sync", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/listing-expiration", "schedule": "0 7 * * *" },
    { "path": "/api/cron/search-alerts", "schedule": "30 7 * * *" },
    { "path": "/api/cron/data-retention", "schedule": "0 3 * * *" }
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mallan.nyc"
        }
      ],
      "destination": "https://mallan.nyc/:path*",
      "permanent": true
    },
    {
      "source": "/exclusives",
      "destination": "/buy?exclusive=mallan",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/crm/login.html" },
    { "source": "/crm", "destination": "/crm/MALLAN-NYC-CRM-FINAL2.html" },
    { "source": "/crm/dashboard", "destination": "/crm/MALLAN-NYC-CRM-FINAL2.html" },
    { "source": "/crm/login", "destination": "/crm/login.html" },
    { "source": "/crm/search", "destination": "/crm/index-built.html" },
    { "source": "/crm/sale-listing", "destination": "/crm/SALE-FORM-REDESIGN.html" },
    { "source": "/crm/rental-listing", "destination": "/crm/RENTAL-FORM-REDESIGN.html" },
    { "source": "/crm/sale-view", "destination": "/crm/SALE-FORM-WITH-TOOLS.html" },
    { "source": "/crm/rental-view", "destination": "/crm/RENTAL-FORM-WITH-TOOLS.html" },
    { "source": "/crm/buyer-deal", "destination": "/crm/BUYER-DEAL-FORM.html" },
    { "source": "/crm/tenant-deal", "destination": "/crm/TENANT-DEAL-FORM.html" },
    { "source": "/crm/tests/:path*", "destination": "/404" },
    { "source": "/crm/scripts/:path*", "destination": "/404" }
  ]
}
