/**
 * lib/db.ts
 *
 * Exports:
 *   - named `pool` (Pool instance)
 *   - default export (same pool)
 *   - named `q<T>(text, params?)` helper which returns `rows`
 *
 * This implementation:
 *  - avoids annotating Pool as a namespace-type (avoids TS2709)
 *  - supports both ESM and CJS shapes of `pg`
 *  - provides q<T> typed return via cast (avoid TS2347 / TS2339)
 */
import pg from "pg";

const connectionString =
  process.env.DATABASE_URL ??
  "postgresql://dev_user:dev_password@127.0.0.1:5432/mallan";

// Handle ESM vs CJS default shape: (pg as any).Pool when ESM, otherwise pg itself may be Pool
const PoolConstructor = (pg as any).Pool ?? (pg as any);

// Instantiate pool but keep as an inferred type (avoid explicit "Pool" annotation which triggers TS2709)
const pool = new (PoolConstructor as any)({
  connectionString,
  // add other pool options if needed
});

export { pool };
export default pool;

/**
 * q<T>(text, params?) — small helper used across the codebase
 * Returns an array of rows typed as T (default any).
 *
 * IMPORTANT: we call (pool as any).query(...) and cast res.rows to T[] to avoid
 * TypeScript issues with untyped runtime shapes of `pg`.
 */
export async function q<T = any>(text: string, params?: any[]): Promise<T[]> {
  const res = await (pool as any).query(text, params);
  const rows = (res && res.rows) ? (res.rows as T[]) : ([] as T[]);
  return rows;
}
