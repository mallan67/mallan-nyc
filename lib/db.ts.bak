/**
 * lib/db.ts
 *
 * Exports:
 *   - named `pool` (Pool instance)
 *   - default export (same pool)
 *   - named `q<T>(text, params?)` helper which returns `rows`
 *
 * This version avoids calling .query<T>(...) on an untyped function to
 * prevent "Untyped function calls may not accept type arguments" (TS2347).
 * It also avoids explicit `Pool` type annotations (prevents TS2709).
 */

import pg from "pg";

const connectionString =
  process.env.DATABASE_URL ??
  "postgresql://dev_user:dev_password@127.0.0.1:5432/mallan";

// Handle ESM vs CJS export shapes
const PoolConstructor = (pg as any).Pool ?? (pg as any);

// Create pool (let TS infer the runtime type, avoid annotating with Pool)
const pool = new (PoolConstructor as any)({
  connectionString,
  // add other pool options if needed
});

export { pool };
export default pool;

/**
 * q<T>(sql, params?) — small helper used across the codebase
 * Returns an array of rows typed as T (default any).
 *
 * IMPORTANT: we do NOT call (pool as any).query<T>(...) because `.query`
 * is currently untyped from the runtime cast. Instead we call `.query(...)`
 * and cast `res.rows` to T[] before returning.
 */
export async function q<T = any>(text: string, params?: any[]): Promise<T[]> {
  const res = await (pool as any).query(text, params);
  // guard and cast rows to T[]
  const rows = (res && res.rows) ? (res.rows as T[]) : ([] as T[]);
  return rows;
}
