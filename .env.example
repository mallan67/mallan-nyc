# Database (required for Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# SendGrid (required for email functionality)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@mallan.nyc

# Anthropic (optional — server-side only, for AI-powered RLS compliance validation)
# Used by: /api/compliance/validate-ai (auth-gated, agent/broker only)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (optional — server-side only, for CRM AI chat assistant)
# Used by: /api/ai (auth-gated, agent/broker only)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# IDX/MLS Integration (REBNY RLS)
# =============================================================================
# COMPLIANCE CRITICAL: MLS/IDX data must only be accessed server-side.
# See README.md for full compliance requirements.

# Feature flag - set to 'true' to enable IDX integration (default: false)
IDX_ENABLED=false

# Trestle/Cotality OAuth2 credentials (provided by REBNY after approval)
# DO NOT commit actual credentials. Use Vercel environment secrets.
# These MUST match the variable names used in lib/idx/auth.ts
IDX_CLIENT_ID=
IDX_CLIENT_SECRET=

# Trestle API base URL (migrated from CoreLogic — deadline March 31, 2026)
# Old URLs (api-trestle.corelogic.com, api-prod.corelogic.com) are DEPRECATED
TRESTLE_API_URL=https://api.cotality.com/trestle

# Token refresh buffer in seconds (default: 300 = 5 minutes before expiry)
IDX_TOKEN_EXPIRY_BUFFER=300

# Cron job authentication (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# =============================================================================

# =============================================================================
# Cloudflare R2 (image storage — zero egress fees)
# =============================================================================
# Create at: Cloudflare Dashboard > R2 > Create Bucket > "mallan-images"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mallan-images
R2_PUBLIC_URL=

# =============================================================================

# Public vars (available client-side)
# NEXT_PUBLIC_API_URL=https://mallan.nyc
