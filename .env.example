# Database (required for Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# SendGrid (required for email functionality)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@mallan.nyc

# Anthropic (optional - for AI-powered compliance validation)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# IDX/MLS Integration (REBNY RLS)
# =============================================================================
# COMPLIANCE CRITICAL: MLS/IDX data must only be accessed server-side.
# See README.md for full compliance requirements.

# Feature flag - set to 'true' to enable IDX integration (default: false)
IDX_ENABLED=false

# Trestle/CoreLogic credentials (provided by REBNY after approval)
# DO NOT commit actual credentials. Use environment secrets.
IDX_API_KEY=
IDX_API_SECRET=

# IDX endpoint URL (provided by Trestle after approval)
IDX_ENDPOINT=

# Cache refresh interval in milliseconds (default: 5 minutes)
IDX_REFRESH_INTERVAL_MS=300000

# =============================================================================

# Public vars (available client-side)
# NEXT_PUBLIC_API_URL=https://mallan.nyc
