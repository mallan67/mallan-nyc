        "@types/pg": "^8.15.6",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@types/sharp": "^0.31.1",
        "@typescript-eslint/eslint-plugin": "^8.46.4",
        "@typescript-eslint/parser": "^8.46.4",
        "commander": "^14.0.3",
        "csv-parse": "^6.1.0",
        "eslint": "^9.39.3",
