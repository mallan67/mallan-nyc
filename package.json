        "bcryptjs": "^3.0.2",
        "groq-sdk": "^1.1.1",
        "gsap": "^3.14.2",
        "gtfs-realtime-bindings": "^1.1.1",
        "leaflet": "^1.9.4",
        "maplibre-gl": "^5.19.0",
        "next": "^16.1.6",
