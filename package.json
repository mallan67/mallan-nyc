{
    "name": "mallan-nyc",
    "version": "0.1.0",
    "private": true,
    "author": "Mallan Real Estate Inc. <hello@mallan.nyc> (https://mallan.nyc)",
    "license": "MIT",
    "homepage": "https://mallan.nyc",
    "engines": {
        "node": "20.x"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "db:migrate": "prisma migrate deploy",
        "start": "next start",
        "lint": "next lint",
        "type-check": "tsc --noEmit",
        "ci": "npm run -s lint && npm run -s type-check && npm run -s build",
        "postinstall": "prisma generate",
        "generate:registry": "node scripts/generate-master-registry.js",
        "validate:standalone": "node scripts/validate-standalone.js validate all",
        "backup:standalone": "node scripts/validate-standalone.js backup all",
        "rls:validate": "node scripts/validate-rls-compliance.js",
        "rls:generate": "node scripts/generate-rls-bindings.js",
        "rls:inject": "node scripts/inject-rls-attributes.js",
        "test:rls": "node scripts/test-rls-bindings.js",
        "db:seed": "npx tsx prisma/seed.ts",
        "crm:build": "node public/crm/build.js",
        "crm:test": "node public/crm/tests/05-test-suite-runner.js",
        "rls:v2": "npx tsx lib/rls-validator/src/cli.ts",
        "rls:v2:test": "npx jest --config lib/rls-validator/jest.config.js",
        "test:compliance": "npx jest --config lib/compliance/jest.config.js",
        "geo:fetch-names": "node scripts/fetch-rls-neighborhoods.js",
        "geo:build": "node scripts/build-rls-geojson.js",
        "geo:derive": "node scripts/build-rls-geo-derived.js",
        "geo:validate": "node scripts/validate-rls-geo.js",
        "geo:aliases": "node scripts/build-rls-aliases.js",
        "geo:all": "npm run geo:build && npm run geo:aliases && npm run geo:derive && npm run geo:validate",
        "test:geo": "node scripts/__tests__/neighborhood-expansion.test.js"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.50.0",
        "@aws-sdk/client-s3": "^3.986.0",
        "@prisma/client": "^6.17.1",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-navigation-menu": "^1.2.14",
        "@sendgrid/mail": "^8.1.6",
        "@tailwindcss/postcss": "^4.1.18",
        "@types/leaflet": "^1.9.21",
        "bcryptjs": "^3.0.2",
        "gsap": "^3.14.2",
        "gtfs-realtime-bindings": "^1.1.1",
        "leaflet": "^1.9.4",
        "next": "^15.5.12",
        "pg": "^8.16.3",
        "prisma": "^6.17.1",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-leaflet": "^4.2.1",
        "sharp": "^0.34.5",
        "swr": "^2.3.6"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.11.30",
        "@types/pg": "^8.15.6",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@types/sharp": "^0.31.1",
        "@typescript-eslint/eslint-plugin": "^8.46.4",
        "@typescript-eslint/parser": "^8.46.4",
        "commander": "^14.0.3",
        "csv-parse": "^6.1.0",
        "eslint": "^8.57.0",
        "eslint-config-next": "^15.5.12",
        "jest": "^30.2.0",
        "node-html-parser": "^7.0.2",
        "postcss": "^8.4.35",
        "tailwindcss": "^4.1.18",
        "ts-jest": "^29.4.6",
        "typescript": "^5.4.0",
        "zod": "^4.3.6"
    }
}
