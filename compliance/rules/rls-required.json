  "conditional": {
    "commonInterest_StockCooperative": {
      "trigger": "CommonInterest = StockCooperative",
      "fields": ["MaximumFinancingPercent", "NumberOfShares", "SpecialListingConditions", "FlipTax", "AssociationFee", "AssociationFeeFrequency", "TaxAbatementYN"]
    },
    "commonInterest_Condominium": {
      "trigger": "CommonInterest = Condominium",
      "fields": ["LivingArea", "PercentOfCommonElements", "TaxMonthlyAmount", "SpecialListingConditions", "TaxLot", "FlipTax", "AssociationFee", "AssociationFeeFrequency", "TaxAbatementYN"]
    },
    "commonInterest_Condop": {
      "trigger": "CommonInterest = Condop",
      "fields": ["SpecialListingConditions", "NumberOfShares", "MaximumFinancingPercent", "FlipTax", "AssociationFee", "AssociationFeeFrequency", "TaxAbatementYN"]
    },
    "status_Closed": {
      "trigger": "MlsStatus = Closed",
      "fields": ["CloseDate", "ClosePrice", "BuyerAgentRLSParticipantYN"]
    },
    "status_Pending": {
      "trigger": "MlsStatus = Pending",
      "fields": ["PurchaseContractDate"]
    },
    "status_Withdrawn": {
      "trigger": "MlsStatus = Withdrawn",
      "fields": ["WithdrawnDate"],
      "rules": ["WithdrawnDate must equal OffMarketDate"]
    },
    "status_Cancelled": {
      "trigger": "MlsStatus = Cancelled",
      "fields": ["CancellationDate"]
    },
    "status_ComingSoon": {
      "trigger": "MlsStatus = ComingSoon",
      "fields": ["ActivationDate"],
      "rules": ["Within 14 calendar days", "Cannot be changed once set", "Sales only — not rentals, not new development"]
    },
    "newDevelopment": {
      "trigger": "NewDevelopmentYN = true",
      "fields": [],
      "rules": ["RUNDBA upload required before RLS submission"]
    },
    "furnished": {
      "trigger": "Furnished = Furnished | Partially | Negotiable",
      "fields": ["FurnishedListPrice"]
    },
    "buyerAgentNonParticipant": {
      "trigger": "BuyerAgentRLSParticipantYN = false AND any Buyer field filled",
      "fields": ["BuyerAgentFullName", "BuyerAgentDirectPhone", "BuyerAgentEmail", "BuyerAgentStateLicense", "BuyerOfficeName", "BuyerOfficePhone"]
    },
    "alternateStreet": {
      "trigger": "Any AlternateStreet* field is submitted",
      "fields": ["AlternateStreetNumber", "AlternateStreetName"]
    },
    "viewYN": {
      "trigger": "ViewYN = true",
      "fields": ["View", "ViewRemarks"]
    },
    "unitNumber": {
      "trigger": "PropertySubType in [Apartment, DeededParking, GardenApartment, Loft, Office, Retail, Timeshare, UnitDuplex, UnitQuadruplex, UnitTriplex]",
      "fields": ["UnitNumber"]
    },
    "taxAnnualAmount": {
      "trigger": "PropertySubType in [Duplex, MixedUse, MultiFamily, MultiFamilyTownhouse, Quadruplex, SingleFamily, SingleFamilyTownhouse, Triplex, UnimprovedLand]",
      "fields": ["TaxAnnualAmount"]
    }
  },
  "crossFieldValidation": [
    {
      "rule": "Borough-County match",
      "fields": ["CityRegion", "CountyOrParish"],
      "mapping": { "Brooklyn": "Kings", "Queens": "Queens", "Manhattan": "New York", "Staten Island": "Richmond", "Bronx": "Bronx" }
    },
    {
      "rule": "City must be NYC",
      "fields": ["City"],
      "value": "New York"
    },
    {
      "rule": "State must be NY",
      "fields": ["StateOrProvince"],
      "value": "NY"
    },
    {
      "rule": "Listing agreement matches property type",
      "fields": ["ListingAgreement", "PropertyType"],
      "rules": ["Residential cannot have Exclusive Right To Lease", "ResidentialLease cannot have Exclusive Right To Sell"]
    },
    {
      "rule": "Permissions mutex",
      "fields": ["Permissions"],
      "rules": ["Cannot be both Owner Opt-Out AND Participant Only"]
    },
    {
      "rule": "Date ordering",
      "fields": ["ListingContractDate", "OnMarketDate", "PurchaseContractDate", "CloseDate"],
      "rules": ["ListingContractDate <= OnMarketDate <= PurchaseContractDate <= CloseDate"]
    },
    {
      "rule": "Listing contract max",
      "fields": ["ListingContractDate"],
      "rules": ["Cannot be more than 1 year from current date"]
    },
    {
      "rule": "Expiration max",
      "fields": ["ExpirationDate"],
      "rules": ["Maximum 10 years"]
    },
    {
      "rule": "BathroomsTotal consistency",
      "fields": ["BathroomsFull", "BathroomsHalf", "BathroomsTotal"],
      "rules": ["BathroomsTotal = BathroomsFull + (BathroomsHalf * 0.5)"]
    },
    {
      "rule": "No future CloseDate",
      "fields": ["CloseDate"],
      "rules": ["CloseDate cannot be in the future"]
    },
    {
      "rule": "BuildingPetsAllowed cascade",
      "fields": ["BuildingPetsAllowed", "PetsAllowed"],
      "rules": ["If BuildingPetsAllowed = No, then PetsAllowed MUST also = No"]
    }
  ]
}
