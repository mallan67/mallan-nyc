  "_meta": {
    "description": "Fields a Mallan listing must carry, and the conditions under which further fields become required.",
    "authority": "REBNY UCBA 2026 Exhibit A",
    "appliesTo": "Mallan-authored listings. mallan.nyc does not transmit listings to REBNY; submission is via RealPlus (LMP). This records the obligation, which governs the listing regardless of the transport.",
    "vocabulary": "Field names are the vocabulary UCBA Exhibit A uses. They are not a Mallan storage schema and are not a provider mapping.",
