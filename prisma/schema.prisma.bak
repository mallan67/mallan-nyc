generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------
// AGENT (natural key = email)
// --------------------------------------------------
model Agent {
  email         String   @id                      @map("email")
  fullName      String   @unique                  @map("full_name")
  firstName     String                        @map("first_name")
  lastName      String                        @map("last_name")
  secondEmail   String?                       @map("second_email")
  licenseNo     String   @unique               @map("license_no")
  licenseExpiry DateTime                       @map("license_expiry")
  saleSplit     Int                            @map("sale_split")
  rentalSplit   Int                            @map("rental_split")
  role          Role     @default(AGENT)        @map("role")
  createdAt     DateTime @default(now())       @map("created_at")
  updatedAt     DateTime @updatedAt            @map("updated_at")

  listings    Listing[]
  leads       Lead[]
  deals       Deal[]
  commissions Commission[]
  splits      Split[]
  splitPlans  SplitPlan[]
  profile     AgentProfile?

  @@map("agents")
}

// --------------------------------------------------
// AGENT PROFILE (same natural key)
// --------------------------------------------------
model AgentProfile {
  email        String   @id                      @map("email") // same as Agent
  agent        Agent    @relation(fields: [email], references: [email], onDelete: Cascade)
  secondEmail  String?                      @map("second_email")
  saleSplit    Int                           @map("sale_split")
  rentalSplit  Int                           @map("rental_split")
  createdAt    DateTime @default(now())      @map("created_at")
  updatedAt    DateTime @updatedAt           @map("updated_at")

  @@map("agent_profiles")
}

// --------------------------------------------------
// DEAL (natural key = address + agentFullName + contractSigned)
// --------------------------------------------------
model Deal {
  address        String   @map("address")
  agentFullName  String   @map("agent_full_name")
  agent          Agent    @relation(fields: [agentFullName], references: [fullName], onDelete: Cascade)
  type           String                        @map("type") // SALE or RENTAL
  status         DealStatus @default(LEAD)     @map("status")
  price          Int                           @map("price")
  closingDate    DateTime?                     @map("closing_date")
  contractSigned DateTime                       @map("contract_signed")
  createdAt      DateTime @default(now())      @map("created_at")
  updatedAt      DateTime @updatedAt           @map("updated_at")

  commissions      Commission[]
  dealDetails      DealDetail?

  @@id([address, agentFullName, contractSigned])   // natural composite key
  @@map("deals")
}

// --------------------------------------------------
// DEAL DETAIL (same natural key)
// --------------------------------------------------
model DealDetail {
  address            String   @map("address")
  agentFullName      String   @map("agent_full_name")
  contractSigned     DateTime @map("contract_signed")
  deal               Deal     @relation(fields: [address, agentFullName, contractSigned], references: [address, agentFullName, contractSigned], onDelete: Cascade)
  agentFirstName     String   @map("agent_first_name")
  agentLastName      String   @map("agent_last_name")
  agentLicense       String   @map("agent_license")
  type               String   @map("type")   // SALE or RENTAL
  price              Int      @map("price")
  agentCommissionPct Int      @map("agent_commission_pct")
  agentCommissionUsd Int      @map("agent_commission_usd")
  split              Int      @map("split")
  contractClosed     DateTime? @map("contract_closed")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt      @map("updated_at")

  @@id([address, agentFullName, contractSigned])   // same composite key
  @@map("deal_details")
}

// --------------------------------------------------
// COMMISSION (natural key = same composite key)
// --------------------------------------------------
model Commission {
  address          String   @map("address")
  agentFullName    String   @map("agent_full_name")
  contractSigned   DateTime @map("contract_signed")
  deal             Deal     @relation(fields: [address, agentFullName, contractSigned], references: [address, agentFullName, contractSigned], onDelete: Cascade)
  agent            Agent    @relation(fields: [agentFullName], references: [fullName], onDelete: Cascade)
  gross            Int      @map("gross")
  companyFee       Int      @map("company_fee")
  agentFee         Int      @map("agent_fee")
  paid             Boolean  @default(false) @map("paid")
  createdAt        DateTime @default(now())  @map("created_at")
  updatedAt        DateTime @updatedAt       @map("updated_at")

  @@id([address, agentFullName, contractSigned])   // same composite key
  @@map("commissions")
}

// --------------------------------------------------
// SPLIT (natural key = agentFullName + year)
// --------------------------------------------------
model Split {
  agentFullName String  @map("agent_full_name")
  year          Int     @map("year")      // 2025, 2026, ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦
  agent         Agent   @relation(fields: [agentFullName], references: [fullName], onDelete: Cascade)
  saleSplit     Int     @map("sale_split")
  rentalSplit   Int     @map("rental_split")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@id([agentFullName, year])
  @@map("splits")
}

// --------------------------------------------------
// SUPPORTING TABLES (no id)
// --------------------------------------------------
model SplitPlan {
  name         String @id   @map("name")   // natural key: "80-20", "70-30"
  companySplit Int    @map("company_split")
  agentSplit   Int    @map("agent_split")
  agents       Agent[]
  @@map("split_plans")
}

model Lead {
  email        String   @id   @map("email")   // natural key
  name         String   @map("name")
  phone        String?  @map("phone")
  consentSms   Boolean  @default(false) @map("consent_sms")
  consentEmail Boolean  @default(false) @map("consent_email")
  note         String?  @map("note")
  assignedToId String?  @map("assigned_to_id")   // can be null
  assignedTo   Agent?   @relation(fields: [assignedToId], references: [email])
  createdAt    DateTime @default(now()) @map("created_at")
  @@map("leads")
}

model Listing {
  address   String        @id   @map("address")   // natural key
  price     Int           @map("price")
  beds      Float?        @map("beds")
  baths     Float?        @map("baths")
  sqft      Int?          @map("sqft")
  status    ListingStatus @default(DRAFT) @map("status")
  agentId   String        @map("agent_id") // agent email
  agent     Agent         @relation(fields: [agentId], references: [email])
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  @@map("listings")
}

model Document {
  filename   String  @id @map("filename")    // natural key (unique per folder)
  category   DocCategory @map("category")
  url        String  @map("url")
  uploadedBy String  @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  @@map("documents")
}

// --------------------------------------------------
// ENUMS (unchanged)
// --------------------------------------------------
enum Role {
  ADMIN
  AGENT
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PENDING
  CLOSED
}

enum DealSide {
  BUY
  SELL
  RENT
}

enum DealStatus {
  LEAD
  SHOWING
  OFFER
  CONTRACT_NEGOTIATION
  CLOSED
}

enum DocCategory {
  OFFERING_PLAN
  AGENCY_DISCLOSURE
  LEAD_PAINT
  WINDOW_GUARD
  FORM_1099
  MISC
}


