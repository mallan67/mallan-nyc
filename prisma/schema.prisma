// ═══════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════
// X. LIFECYCLE TRIGGERS — Event-driven automation rules
// ═══════════════════════════════════════════════════════════
model LifecycleTrigger {
  id               BigInt    @id @default(autoincrement())
  name             String
  trigger_type     String    @map("trigger_type") // conviction_threshold, ghost_detected, comparable_sale, market_window, momentum_drop, inquiry_stale
  conditions       Json      @default("{}") // e.g., { min_score: 75 } or { silence_days: 7 }
  action_type      String    @map("action_type") // notification, email, agent_alert, crm_task
  action_config    Json      @default("{}") // template, recipients, etc.
  enabled          Boolean   @default(true)
  cooldown_hours   Int       @default(24) @map("cooldown_hours")
  last_executed_at DateTime? @map("last_executed_at")
  execution_count  Int       @default(0) @map("execution_count")

  executions TriggerExecution[]

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@index([trigger_type])
  @@index([enabled])
  @@map("lifecycle_triggers")
}

model TriggerExecution {
  id          BigInt           @id @default(autoincrement())
  trigger_id  BigInt           @map("trigger_id")
  trigger     LifecycleTrigger @relation(fields: [trigger_id], references: [id])
  target_type String           @map("target_type") // lead, listing, agent
  target_id   String           @map("target_id")
  context     Json             @default("{}")
  result      String           @default("success") // success, suppressed, failed
  created_at  DateTime         @default(now()) @map("created_at")

  @@index([trigger_id])
  @@index([target_type, target_id])
  @@index([created_at])
  @@map("trigger_executions")
}

