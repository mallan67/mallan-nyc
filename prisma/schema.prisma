// ═══════════════════════════════════════════════════════════
// Z. PROTECTED PERIOD — UCBA A6/A7/A8 exclusive expiration
// Internal audit compliance — NOT sent to RLS/Trestle.
// Agent has 7 business days to submit up to 6 buyer names after
// exclusive expires. 90-day protection window for compensation.
// ═══════════════════════════════════════════════════════════
model ProtectedPeriod {
  id         BigInt  @id @default(autoincrement())
  listing_id BigInt  @unique @map("listing_id")
  listing    Listing @relation(fields: [listing_id], references: [id])
  agent_id   BigInt  @map("agent_id")
  agent      Agent   @relation(fields: [agent_id], references: [id])

  // Dates
  agreement_expired_at DateTime  @map("agreement_expired_at") // When the exclusive agreement expired
  names_deadline       DateTime  @map("names_deadline") // 7 business days after expiration
  protection_ends_at   DateTime  @map("protection_ends_at") // 90 calendar days after expiration
  names_submitted_at   DateTime? @map("names_submitted_at")
  notice_uploaded_at   DateTime? @map("notice_uploaded_at") // When notice of expired listing was uploaded

  // Status tracking
  // pending_names → active → expired | converted
  // pending_names → missed_deadline (if 7 biz days pass with no names)
  status String @default("pending_names")

  // Notice document (internal audit — not sent to RLS)
  notice_document_id BigInt? @map("notice_document_id")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  protected_buyers ProtectedBuyer[]

  @@index([agent_id])
  @@index([status])
  @@index([protection_ends_at])
  @@index([names_deadline])
  @@map("protected_periods")
}

model ProtectedBuyer {
  id                  BigInt          @id @default(autoincrement())
