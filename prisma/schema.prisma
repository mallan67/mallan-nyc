// ─────────────────────────────────────────────────────────────────────────────
// Inquiry — captured from public lead-capture endpoints + bridges Lead↔Listing.
// Added in Workstream C1 of master refactor (memory/REFACTOR-2026-04-25.md).
// Replaces the AuditEvent-based workaround in /api/crm/inquiries.
// UCBA Art. III §4 (data accuracy + reporting): provides a real source for
// per-listing inquiry counts that were previously TODO'd as 0.
// ─────────────────────────────────────────────────────────────────────────────
model Inquiry {
  id                  BigInt    @id @default(autoincrement())
  // FK to Listing (nullable — some inquiries are not listing-specific:
  // CMA requests, generic contact, sign-up, guide downloads).
  // References Listing.listing_id (the unique string key — Trestle ListingId
  // or SL-/RL- internal prefix) rather than Listing.id (BigInt PK), since
  // every public lead-capture endpoint already works with the string key.
  listing_id          String?   @map("listing_id")
  listing             Listing?  @relation(fields: [listing_id], references: [listing_id])
  // FK to Lead (nullable — the inquiry can arrive before a Lead row is
  // created if the lead-capture endpoint dedupes by email after the fact).
  lead_id             BigInt?   @map("lead_id")
  lead                Lead?     @relation(fields: [lead_id], references: [id])
  // Source of the inquiry — drives reporting + routing logic.
  // Values: contact_form | inquiry | cma_request | open_house_rsvp |
  //         guide_download | favorite | search_alert | sign_up
  source              String
  // Free-text inquiry message if the source captured one (contact form,
  // inquiry form). Scanned for Fair Housing on display in CRM.
  message             String?   @db.Text
  // Mirror of consent at the moment of inquiry — TCPA/CAN-SPAM trail.
  // Stamped on every Inquiry independently of Lead.consent_captured_at so
  // the source-of-truth survives Lead row mutations.
  consent_captured_at DateTime? @map("consent_captured_at")
  // Direct contact fields (captured before Lead row exists, or for
  // anonymous inquiries that never become Leads).
  email               String?
  phone               String?
  first_name          String?   @map("first_name")
  last_name           String?   @map("last_name")
  // Optional anti-bot + audit context.
  user_agent          String?   @map("user_agent") @db.Text
  // SHIELD Act: hash, never raw IP.
  ip_hash             String?   @map("ip_hash")
  // Route-specific extras (e.g., guide slug, search alert id, listing id
  // from a portal action). Free-form Json kept small and exception-only.
  metadata            Json?
  created_at          DateTime  @default(now()) @map("created_at")

  @@index([listing_id])
  @@index([lead_id])
  @@index([source])
  @@index([created_at])
  @@index([email])
  @@map("inquiries")
}

// ─────────────────────────────────────────────────────────────────────────────
// ListingMedia — per-photo records keyed by Trestle Media.ResourceRecordKey.
// Master refactor PR 2 (memory/REFACTOR-2026-04-25.md).
//
// Replaces the heavy `media` JSON column on Listing during the migration:
//   PR 2 (this) — add table + Listing nullable cols
//   PR 3 — populate via media-sync cron driven by PhotosChangeTimestamp
//   PR 4 — readers swap from Listing.media JSON to listing_media table
//   PR 10 — drop Listing.media JSON
//
// Trestle key discipline (per 2026-04-07 vendor guidance — see CLAUDE.md):
//   media_key            = Media.MediaKey          — unique PK in Trestle
//   resource_record_key  = Property.ListingKey     — UNIQUE across MLOs (use this)
//   resource_record_id   = Property.ListingID      — may DUPLICATE across MLOs
// Always join via resource_record_key. resource_record_id is kept for legacy.
// ─────────────────────────────────────────────────────────────────────────────
model ListingMedia {
  id                        BigInt    @id @default(autoincrement())
  listing_id                String    @map("listing_id")
  listing                   Listing   @relation(fields: [listing_id], references: [listing_id], onDelete: Cascade)
  media_key                 String?   @unique @map("media_key")
  resource_record_key       String?   @map("resource_record_key")
  resource_record_id        String?   @map("resource_record_id")
  // Public URLs — original is the Trestle source; cached is the R2 mirror.
  media_url_original        String?   @map("media_url_original") @db.Text
  media_url_cached          String?   @map("media_url_cached") @db.Text
  // Trestle MediaType (Photo/FloorPlan/Video/Virtual3D/...) + MediaCategory.
  media_type                String    @map("media_type")
  media_category            String?   @map("media_category")
  media_classification      String?   @map("media_classification")
  // Display ordering + preferred flag (Trestle PreferredPhotoYN).
  order                     Int       @default(0)
  preferred_photo_yn        Boolean   @default(false) @map("preferred_photo_yn")
  // Trestle change-detection timestamps.
  // - media_modification_ts ← Media.MediaModificationTimestamp (newest source-of-truth)
  // - modification_ts       ← Media.ModificationTimestamp       (alternate, some feeds)
  // - photos_change_ts_snapshot ← Property.PhotosChangeTimestamp at the moment
  //   we ingested this row, so we can reason about which Property-level event
  //   produced this Media-level change.
  media_modification_ts     DateTime? @map("media_modification_ts")
  modification_ts           DateTime? @map("modification_ts")
  photos_change_ts_snapshot DateTime? @map("photos_change_ts_snapshot")
  // R2 cache info — populated when the photo is mirrored to R2 (PR 3).
  r2_key                    String?   @map("r2_key")
  width                     Int?
  height                    Int?
  // R2 mirror cooldown / N-strikes (added 2026-05-10 to break the persistent
  // retry loop on stale Trestle media URLs that return HTTP 404 with body
  // "ERROR - External media was not downloaded"; root-cause confirmed by E8
  // probe in `memory/PR3-PRODUCTION-ROLLOUT-2026-05-09.md`).
  //   - r2_last_attempt_at: NULL means "never attempted"; non-null is the
  //     wall-clock timestamp of the last failed mirror attempt. Phase 3
  //     skips rows where this is < 6 hours old.
  //   - r2_attempts: NULL or 0 means "no failed attempts pending"; >0 is
  //     the consecutive-failure counter. After 3 confirmed HTTP 404
  //     responses, Cp4 soft-deletes the row (status='deleted').
  // Both nullable per NEON.md §4 — never NOT NULL DEFAULT on a populated
  // table. Code reads with `?? 0` / `?? null` defaults.
  r2_last_attempt_at        DateTime? @map("r2_last_attempt_at")
  r2_attempts               Int?      @map("r2_attempts")
  // R2 DELIVERY-POLICY STATE — separate from the retry/failure state above.
  //
  // `r2_attempts` had been overloaded to carry a POLICY decision: the sentinel
  // value 9 (R2_POLICY_PARKED_ATTEMPTS) meant "current mirror policy declines
  // to mirror this asset", stored in a column whose name, type and selector
  // semantics all say FAILURE. A policy exclusion is not a failure: it must
  // never look retry-exhausted, never inflate a failure count it did not earn,
  // and never block later re-admission.
  //
  //   NULL     = not excluded by policy
  //   non-NULL = excluded by policy, at that wall-clock time (the age gives a
  //              bounded re-evaluation window without a second column)
  //
  // ONE nullable timestamp covers all three required states, so no
  // status+reason+timestamp trio. Nullable, no default, reversible —
  // NEON.md §4 "Good SQL patterns". Interpreted ONLY by
  // lib/media/r2-policy-state.ts; legacy exact-9 rows stay readable there.
  r2_policy_excluded_at     DateTime? @map("r2_policy_excluded_at")
  // Status: 'active' | 'deleted' (soft-delete for audit) | 'replaced'.
  // We never hard-delete a media row so the audit trail stays intact.
  status                    String    @default("active")
  created_at                DateTime  @default(now()) @map("created_at")
  updated_at                DateTime  @updatedAt @map("updated_at")

  /// STEP 1 of the content-check state machine (authorized 2026-08-19).
  /// Last time a content check was ATTEMPTED AND CONCLUDED for this MediaKey, whatever the
  /// outcome. Interpretation is qualified by content_check_state — which is why one timestamp
  /// alone cannot carry this. NULL = never checked.
  content_check_at          DateTime? @map("content_check_at")

  /// STEP 2 of the content-check state machine (authorized 2026-08-19).
  /// NULL | 'VERIFIED' | 'MISMATCH' | 'INDETERMINATE'. Constrained by the APPLICATION contract
  /// (lib/media/content-verification.ts), deliberately NOT a database enum — the repo already models
  /// controlled state as String (see ListingMedia.status), and an enum would make future value
  /// additions a migration.
  content_check_state       String?   @map("content_check_state")

  @@index([listing_id])
  @@index([resource_record_key])
  @@index([media_modification_ts])
  @@index([modification_ts])
  @@index([status])
  @@map("listing_media")
}

// ─────────────────────────────────────────────────────────────────────────────
// MediaSyncState — per-resource cursor for the incremental media sync cron.
// Populated by app/api/cron/media-sync/route.ts (introduced in PR 3).
//
// Two-tier watermark strategy per Trestle vendor guidance:
//   1. last_photos_change   ← max(Property.PhotosChangeTimestamp) — high-level
//      trigger to identify which listings have any media change.
//   2. last_media_modified  ← max(Media.ModificationTimestamp /
//      Media.MediaModificationTimestamp) — per-row change detection within
//      the listings flagged by step 1.
// ─────────────────────────────────────────────────────────────────────────────
model MediaSyncState {
  id                  BigInt    @id @default(autoincrement())
  resource            String    @unique
  last_photos_change  DateTime? @map("last_photos_change")
  last_media_modified DateTime? @map("last_media_modified")
  // RC1 keyset cursor tie-breaker: the ListingKey of the last fully-processed
  // listing at the last_photos_change watermark. Enables same-timestamp
  // continuation `(PhotosChangeTimestamp = ts AND ListingKey > last_listing_key)`
  // so a run of >listingsPerRun listings sharing one PhotosChangeTimestamp can
  // no longer starve the cursor. Nullable (null = no tie-breaker yet / legacy).
  last_listing_key    String?   @map("last_listing_key")
  last_run_at         DateTime? @map("last_run_at")
  last_run_status     String?   @map("last_run_status")
  rows_checked        Int       @default(0) @map("rows_checked")
  rows_updated        Int       @default(0) @map("rows_updated")
  rows_failed         Int       @default(0) @map("rows_failed")
  created_at          DateTime  @default(now()) @map("created_at")
  updated_at          DateTime  @updatedAt @map("updated_at")

  @@map("media_sync_state")
}

// ─────────────────────────────────────────────────────────────────────────────
// Offer — UCBA Art. II transmission tracking.
// Workstream C2 of master refactor (memory/REFACTOR-2026-04-25.md +
// memory/FOLLOWUP-2026-05-01.md). UCBA Art. II requires brokers to disclose
// every received offer to the seller and tracks the transmit-to-seller event.
// Multiple-bid disclosure (telling one buyer about competing offers) is
// only allowed when the seller has explicitly authorized it.
//
// Buyer/agent identifiers are stored as plain BigInt fields without FK
// constraints to avoid back-reference churn on the heavily-relationed Lead
// and Agent models. FK enforcement can be added in a follow-up migration
// if the audit usage pattern requires it.
// ─────────────────────────────────────────────────────────────────────────────
model Offer {
  id                              BigInt    @id @default(autoincrement())
  // Listing the offer is on. FK + ON DELETE SET NULL preserves the offer
  // record for the audit trail even if the listing is later removed.
  listing_id                      String?   @map("listing_id")
  listing                         Listing?  @relation(fields: [listing_id], references: [listing_id], onDelete: SetNull, onUpdate: Cascade)

  // Buyer (the lead making the offer) — BigInt only, no FK. Indexed below.
  buyer_lead_id                   BigInt?   @map("buyer_lead_id")
  // Buyer's agent (the broker submitting on behalf of buyer) — BigInt only.
  buyer_agent_id                  BigInt?   @map("buyer_agent_id")
  // Listing agent (us, when we're representing the seller) — BigInt only.
  list_agent_id                   BigInt?   @map("list_agent_id")

  // ── Offer details ─────────────────────────────────────────────────────
  offer_amount                    Decimal?  @map("offer_amount") @db.Decimal(14, 2)
  offer_terms                     String?   @db.Text
  // Contingencies as a structured payload. Free-form JSON kept small —
  // typical shape: { financing: bool, inspection: bool, sale: bool,
  //                  appraisal: bool, custom: string[] }.
  contingencies                   Json?
  expiration_at                   DateTime? @map("expiration_at")

  // ── UCBA Art. II three-state transmission lifecycle ──────────────────
  // 1. Agent received the offer from buyer/buyer's broker.
  received_at                     DateTime? @map("received_at")
  // 2. Agent transmitted the offer to the seller (UCBA REQUIRED).
  //    POST /api/crm/offers/[id]/transmit stamps this + writes AuditEvent.
  transmitted_to_seller_at        DateTime? @map("transmitted_to_seller_at")
  // 3. Seller acknowledged review of the offer.
  seller_acknowledged_at          DateTime? @map("seller_acknowledged_at")

  // ── UCBA Art. II multiple-bid disclosure ─────────────────────────────
  // Whether competing offers have been disclosed to this buyer.
  competing_offers_disclosed      Boolean   @default(false) @map("competing_offers_disclosed")
  // Required precondition: seller must explicitly authorize disclosure.
  // Defaults to false — a broker disclosing competing bids without this
  // flag set true is a UCBA Art. II violation.
  disclosure_authorized_by_seller Boolean   @default(false) @map("disclosure_authorized_by_seller")

  // ── Status ────────────────────────────────────────────────────────────
  // received | transmitted | accepted | rejected | countered | withdrawn | expired
  status                          String    @default("received")

  created_at                      DateTime  @default(now()) @map("created_at")
  updated_at                      DateTime  @updatedAt @map("updated_at")

  @@index([listing_id])
  @@index([buyer_lead_id])
  @@index([buyer_agent_id])
  @@index([list_agent_id])
  @@index([status])
  @@index([transmitted_to_seller_at])
  @@index([received_at])
  @@map("offers")
}

// ═══════════════════════════════════════════════════════════
// Listing search projection (master refactor PR 5A — additive)
// ═══════════════════════════════════════════════════════════
// Lean denormalized read-model for public + agent + saved-search /
// search-alert listing search. Columns are flat scalars or small JSON
// payloads sized for fast facet filtering and ranking; the source of
// truth remains `Listing` (and its `address` / `features` / `media`
// JSON columns) until a future PR migrates readers.
//
// PR 5A — schema only. No reader migration yet, no dual-write yet
// (lib/idx/sync.ts is intentionally NOT touched in this slice).
// PR 5B will add dual-write from lib/idx/sync.ts. PR 5C verifies a
// full sync cycle. PR 5D moves one reader at a time per NEON.md §4.
//
// FK relation matches the ListingMedia pattern: references
// Listing.listing_id (String, unique) rather than the BigInt PK.
// onDelete: Cascade prevents orphan projection rows from accumulating
// when an upstream `Listing` is removed (rare in practice — listings
// are tombstoned, not deleted — but cheap defense).
//
// Compliance: distribution-gate booleans are mirrored here so search
// can be fail-closed at the index level without a join back to
// `listings`. The semantic helpers in lib/search/listing-access-decision.ts
// remain the canonical evaluators — readers must continue to use those
// when they migrate to this projection.
model ListingSearchProjection {
  id         BigInt  @id @default(autoincrement())
  listing_id String  @unique @map("listing_id")
  listing    Listing @relation(fields: [listing_id], references: [listing_id], onDelete: Cascade)

  // Cotality/Trestle source tracking (filled by sync — null until PR 5B).
  listing_key   String? @map("listing_key")
  source_system String? @map("source_system")
  mls_status    String? @map("mls_status")

  // Classification
  listing_type      String? @map("listing_type")
  property_type     String? @map("property_type")
  property_sub_type String? @map("property_sub_type")

  // Geography (promoted out of `listings.address` JSON)
  borough      String?
  neighborhood String?
  postal_code  String? @map("postal_code")
  city         String?
  state        String?

  // Numeric search dimensions
  list_price  BigInt? @map("list_price")
  bedrooms    Float?
  bathrooms   Float?
  living_area Float?  @map("living_area")
  year_built  Int?    @map("year_built")
  latitude    Float?
  longitude   Float?

  // Boolean flags for fast facet filtering — derived once at projection
  // build time so search routes don't re-derive on every request.
  is_commercial      Boolean @default(false) @map("is_commercial")
  is_new_development Boolean @default(false) @map("is_new_development")
  is_exclusive       Boolean @default(false) @map("is_exclusive")
  is_rental          Boolean @default(false) @map("is_rental")

  // Distribution-gate mirror — nullable booleans (fail-closed when
  // missing once readers migrate; canonical evaluators in
  // lib/search/listing-access-decision.ts treat null as "not displayable").
  rls_eligible                       Boolean  @default(true) @map("rls_eligible")
  idx_display_yn                     Boolean? @map("idx_display_yn")
  internet_entire_listing_display_yn Boolean? @map("internet_entire_listing_display_yn")
  internet_address_display_yn        Boolean? @map("internet_address_display_yn")
  participant_only_yn                Boolean? @map("participant_only_yn")

  // Free-text + structured supplemental data
  searchable_text String? @map("searchable_text") @db.Text
  amenity_keys    Json?   @map("amenity_keys")
  feature_flags   Json?   @map("feature_flags")

  // Timestamps
  modified_at DateTime? @map("modified_at")
  created_at  DateTime  @default(now()) @map("created_at")
  updated_at  DateTime  @updatedAt @map("updated_at")

  @@index([listing_type, mls_status])
  @@index([borough, neighborhood])
  @@index([postal_code])
  @@index([list_price])
  @@index([bedrooms])
  @@index([bathrooms])
  @@index([property_sub_type])
  @@index([modified_at])
  @@index([rls_eligible, idx_display_yn, internet_entire_listing_display_yn, participant_only_yn], map: "lsp_distribution_gates_idx")
  @@map("listing_search_projection")
}

// ═══════════════════════════════════════════════════════════════════════════════
// B1b-1 — CANONICAL IDENTITY SCHEMA (ADDITIVE · RESERVED · NOT WIRED)
// New empty tables only. No existing column/table is modified. The integer
// `buildings.building_key` is untouched; the Cotality BuildingKey is stored HERE as
// nullable TEXT (`canonical_building.cotality_building_key`). `identity_resolution_status`
// is a constrained String per repo convention (no Postgres enum migration); its 4
// values (resolved|partial|ambiguous|unresolved) are enforced by the canonical
// contract's IdentityResolutionStatus (lib/search/canonical) at write time in a later
// PR. No reader/writer imports these models in B1b-1. Backfill, enrichment, matching,
// and reader/writer wiring are B1b-2..B1b-5, each separately approved.
// DB-LEVEL CHECK CONSTRAINTS (identity/review states + required reasons for
// ambiguous/unresolved) are defined in the migration SQL — Prisma does not model
// arbitrary CHECK constraints, so they are NOT represented in this schema block.
// Do not run `prisma db push`/`migrate dev` against prod (would drop these checks).
// ═══════════════════════════════════════════════════════════════════════════════

model CanonicalProperty {
  id                 BigInt   @id @default(autoincrement())
  bbl                String?  @map("bbl")
  normalized_address String   @map("normalized_address")
  borough            String   @map("borough")
  zip                String   @map("zip")
  latitude           Decimal? @map("latitude") @db.Decimal(10, 7)
  longitude          Decimal? @map("longitude") @db.Decimal(10, 7)
  source_refs        Json     @default("{}") @map("source_refs")
  created_at         DateTime @default(now()) @map("created_at")
  updated_at         DateTime @updatedAt @map("updated_at")

  canonical_buildings CanonicalBuilding[]
  listing_identity    ListingIdentity[]

  @@index([bbl])
  @@index([borough])
  @@index([zip])
  @@index([normalized_address])
  @@map("canonical_property")
}

model CanonicalBuilding {
  id                    BigInt   @id @default(autoincrement())
  canonical_property_id BigInt?  @map("canonical_property_id")
  normalized_street     String   @map("normalized_street")
  zip                   String   @map("zip")
  borough               String   @map("borough")
  building_name         String?  @map("building_name")
  // Cotality BuildingKey stored as TEXT — NEVER the integer buildings.building_key.
  cotality_building_key String?  @map("cotality_building_key")
  bbl                   String?  @map("bbl")
  latitude              Decimal? @map("latitude") @db.Decimal(10, 7)
  longitude             Decimal? @map("longitude") @db.Decimal(10, 7)
  created_at            DateTime @default(now()) @map("created_at")
  updated_at            DateTime @updatedAt @map("updated_at")

  canonical_property CanonicalProperty? @relation(fields: [canonical_property_id], references: [id], onDelete: SetNull)
  canonical_units    CanonicalUnit[]
  listing_identity   ListingIdentity[]

  @@index([canonical_property_id])
  @@index([normalized_street, zip, borough])
  @@index([cotality_building_key])
  @@index([bbl])
  @@map("canonical_building")
}

model CanonicalUnit {
  id                    BigInt   @id @default(autoincrement())
  canonical_building_id BigInt   @map("canonical_building_id")
  normalized_unit       String   @map("normalized_unit")
  floor                 String?  @map("floor")
  line                  String?  @map("line")
  created_at            DateTime @default(now()) @map("created_at")
  updated_at            DateTime @updatedAt @map("updated_at")

  canonical_building CanonicalBuilding @relation(fields: [canonical_building_id], references: [id], onDelete: Cascade)
  listing_identity   ListingIdentity[]

  @@unique([canonical_building_id, normalized_unit])
  @@index([canonical_building_id])
  @@map("canonical_unit")
}

model ListingIdentity {
  id                                BigInt   @id @default(autoincrement())
  // Hard FK to Listing.id (BigInt) — one current identity row per listing; matches
  // the PriceHistory/MarketingActivity listing-lifecycle cascade convention.
  listing_id                        BigInt   @map("listing_id")
  canonical_property_id             BigInt?  @map("canonical_property_id")
  canonical_building_id             BigInt?  @map("canonical_building_id")
  canonical_unit_id                 BigInt?  @map("canonical_unit_id")
  identity_resolution_status        String   @map("identity_resolution_status") // DB CHECK `listing_identity_resolution_status_check` (migration) enforces resolved|partial|ambiguous|unresolved; A1 IdentityResolutionStatus is the app-level second layer
  resolution_reason                 String?  @map("resolution_reason") // DB CHECK `listing_identity_resolution_reason_check` (migration): non-empty required when status is ambiguous|unresolved
  source_record_id                  String   @map("source_record_id") // RLS/Cotality ListingId (text)
  cotality_listing_key              String?  @map("cotality_listing_key") // Cotality ListingKey (text)
  relisting_chain_id                BigInt?  @map("relisting_chain_id") // soft reference; chain table deferred
  evaluated_source_snapshot_version String   @map("evaluated_source_snapshot_version")
  identity_evaluated_at             DateTime @map("identity_evaluated_at")
  created_at                        DateTime @default(now()) @map("created_at")
  updated_at                        DateTime @updatedAt @map("updated_at")

  listing            Listing            @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  canonical_property CanonicalProperty? @relation(fields: [canonical_property_id], references: [id], onDelete: SetNull)
  canonical_building CanonicalBuilding? @relation(fields: [canonical_building_id], references: [id], onDelete: SetNull)
  canonical_unit     CanonicalUnit?     @relation(fields: [canonical_unit_id], references: [id], onDelete: SetNull)

  @@unique([listing_id])
  @@index([identity_resolution_status])
  @@index([canonical_property_id])
  @@index([canonical_building_id])
  @@index([canonical_unit_id])
  @@index([relisting_chain_id])
  @@index([source_record_id])
  @@map("listing_identity")
}

model IdentityMatchAudit {
  id                                BigInt    @id @default(autoincrement())
  // Soft references only (append-only audit; NO FK) so audit history is never
  // destroyed by a listing or identity deletion.
  listing_identity_id               BigInt?   @map("listing_identity_id")
  listing_source_record_id          String?   @map("listing_source_record_id")
  candidate_property_id             BigInt?   @map("candidate_property_id")
  candidate_building_id             BigInt?   @map("candidate_building_id")
  candidate_unit_id                 BigInt?   @map("candidate_unit_id")
  evidence                          Json      @default("{}") @map("evidence")
  evaluated_source_snapshot_version String?   @map("evaluated_source_snapshot_version")
  identity_evaluated_at             DateTime? @map("identity_evaluated_at")
  decision                          String?   @map("decision")
  reason                            String?   @map("reason")
  matcher_version                   String?   @map("matcher_version")
  created_at                        DateTime  @default(now()) @map("created_at")

  @@index([listing_identity_id])
  @@index([listing_source_record_id])
  @@index([created_at])
  @@map("identity_match_audit")
}

model IdentityReviewQueue {
  id                       BigInt    @id @default(autoincrement())
  // Soft reference (NO FK) so review-queue history remains auditable.
  listing_source_record_id String    @map("listing_source_record_id")
  listing_identity_id      BigInt?   @map("listing_identity_id")
  resolution_status        String    @map("resolution_status") // DB CHECK `identity_review_queue_resolution_status_check` (migration): resolved|partial|ambiguous|unresolved
  reason                   String?   @map("reason") // DB CHECK `identity_review_queue_resolution_reason_check` (migration): non-empty required when resolution_status is ambiguous|unresolved
  candidate_payload        Json      @default("{}") @map("candidate_payload")
  review_status            String    @default("open") @map("review_status") // DB CHECK `identity_review_queue_review_status_check` (migration): open|in_review|resolved|rejected
  priority                 Int       @default(0) @map("priority")
  assigned_to              BigInt?   @map("assigned_to") // soft ref to agent
  reviewed_at              DateTime? @map("reviewed_at")
  created_at               DateTime  @default(now()) @map("created_at")
  updated_at               DateTime  @updatedAt @map("updated_at")

  @@index([review_status])
  @@index([listing_source_record_id])
  @@index([resolution_status])
  @@index([created_at])
  @@map("identity_review_queue")
}
