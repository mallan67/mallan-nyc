// prisma/schema.prisma
//
// ⚠  READ `NEON.md` AT THE REPO ROOT BEFORE EDITING THIS FILE.
// It documents tier caps, the required migration pattern (nullable columns
// only, one-per-PR, dual-write), and why Vercel's buildCommand does NOT run
// migrations. Skipping that file is how the 2026-04-19 silent-drift happened.
//
// Pre-flight before any schema edit:
//   1. npm run ops:health                        (compute + storage headroom)
//   2. DATABASE_URL=prod npx prisma migrate deploy   (apply manually FIRST)
//   3. npm run type-check && npm run compliance-check
//   4. Commit with `[neon-preflight: OK]` in the message (enforced by hook).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// ═══════════════════════════════════════════════════════════
// AGENT — Licensed real estate agent or broker
// ═══════════════════════════════════════════════════════════
model Agent {
  id             BigInt    @id @default(autoincrement())
  first_name     String
  last_name      String
  full_name      String?   @db.Text
  email          String    @unique
  password_hash  String    @map("password_hash")
  phone          String?
  license_no     String?   @map("license_no")
  trestle_mls_id String?   @map("trestle_mls_id") // REBNY MLS member ID on Trestle (e.g. "39361") — different from state license_no
  license_type   String?   @map("license_type") // "broker" | "salesperson"
  license_expiry DateTime? @map("license_expiry")
  sale_split     Decimal?  @map("sale_split") @db.Decimal(6, 3)
  rental_split   Decimal?  @map("rental_split") @db.Decimal(6, 3)
  role           String    @default("AGENT") // "BROKER" | "AGENT"
  status         String    @default("active") // "active" | "inactive" | "suspended"
  last_login     DateTime? @map("last_login")

  // --- MFA (TOTP) ---
  mfa_enabled       Boolean  @default(false) @map("mfa_enabled")
  mfa_secret_enc    String?  @map("mfa_secret_enc") @db.Text // AES-256-GCM encrypted TOTP secret
  mfa_backup_hashes String[] @default([]) @map("mfa_backup_hashes") // bcrypt hashes of one-time backup codes

  // --- Public profile fields (shown on mallan.nyc/agents) ---
  public_slug String?  @unique @map("public_slug") // URL slug e.g. "maya-allan"
  title       String?  @db.Text // "Licensed Real Estate Broker"
  bio         String?  @db.Text
  photo       String? // URL path e.g. "/images/agents/maya-allan.jpg"
  specialties String[] @default([])
  languages   String[] @default([])
  featured    Boolean  @default(false)

  leads                Lead[]
  listings             Listing[]
  deals                Deal[]
  past_deals           PastDeal[]
  showings             Showing[]
  saved_searches       SavedSearch[]
  seller_leads         SellerLead[]
  external_listings    ExternalListing[]
  external_listing_comments ExternalListingComment[]
  pricing_experiments  PricingExperiment[]
  demand_alerts        DemandAlert[]
  agent_metrics        AgentMetrics[]
  performance_index    AgentPerformanceIndex?
  cma_reports          CmaReport[]
  documents            Document[]
  assignment_rules     LeadAssignmentRule[]
  protected_periods    ProtectedPeriod[]
  marketing_activities MarketingActivity[]
  follow_up_tasks      FollowUpTask[]         @relation("AgentTasks")
  campaigns            Campaign[]

  // --- Outlook integration (Microsoft Graph OAuth tokens) ---
  outlook_access_token     String?   @map("outlook_access_token") @db.Text
  outlook_refresh_token    String?   @map("outlook_refresh_token") @db.Text
  outlook_token_expires_at DateTime? @map("outlook_token_expires_at")

  active_leases ActiveLease[]

  // --- UCBA 2026 ethics training (Workstream C4) ---
  // UCBA Art. III §6 (new in 2026): ethics training is mandatory for RLS
  // access. Brokers verify each agent's completion + 2-year expiry. Once
  // C4b lands, lib/auth/session.ts will block issuing agent-role tokens
  // when ethics_training_expires_at < now() — returning a 403 with a
  // link to the re-training resource.
  // Both nullable per NEON.md §4 — existing agent rows pre-date the rule.
  ethics_training_completed_at DateTime? @map("ethics_training_completed_at")
  ethics_training_expires_at   DateTime? @map("ethics_training_expires_at")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@map("agents")
}

// ═══════════════════════════════════════════════════════════
// PAST DEAL — Closed deal for public agent profile display
// Editable by broker from CRM backend
// ═══════════════════════════════════════════════════════════
model PastDeal {
  id       BigInt @id @default(autoincrement())
  agent_id BigInt @map("agent_id")
  agent    Agent  @relation(fields: [agent_id], references: [id])

  // --- Address ---
  street       String
  unit         String?
  city         String  @default("New York")
  postal_code  String? @map("postal_code")
  neighborhood String?

  // --- Deal info ---
  deal_type     String    @map("deal_type") // "sale" | "rent"
  property_type String?   @map("property_type") // "Condo" | "Co-op" | "Condop" | "Townhouse" | "Commercial" | "Rental"
  close_price   Decimal?  @map("close_price") @db.Decimal(14, 2)
  close_date    DateTime? @map("close_date")
  beds          Int?
  baths_full    Int?      @map("baths_full")
  baths_half    Int?      @map("baths_half")
  sqft          Int?

  // --- Display ---
  photo_url           String? @map("photo_url") // Uploaded by broker or from Trestle proxy
  listing_courtesy    String? @map("listing_courtesy") // "Listing Courtesy of [broker]" for buyer-rep deals
  source              String  @default("manual") // "trestle" | "manual"
  trestle_listing_id  String? @map("trestle_listing_id") // Trestle ListingId reference
  trestle_listing_key String? @map("trestle_listing_key") // Trestle ListingKey

  // --- Sort order (optional manual override) ---
  sort_order Int? @map("sort_order")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@index([agent_id, deal_type])
  @@index([close_date])
  @@map("past_deals")
}

// ═══════════════════════════════════════════════════════════
// DEAL — Commission request (agent → broker)
// ═══════════════════════════════════════════════════════════
model Deal {
  id                      BigInt              @id @default(autoincrement())
  agent_id                BigInt              @map("agent_id")
  agent                   Agent               @relation(fields: [agent_id], references: [id])
  representation_code     String?             @map("representation_code") // "buyer" | "tenant"
  property_address        String?             @map("property_address")
  price_usd               Decimal?            @map("price_usd") @db.Decimal(14, 2)
  commission_rate_percent Decimal?            @map("commission_rate_percent") @db.Decimal(6, 3)
  split_percent           Decimal?            @map("split_percent") @db.Decimal(6, 3)
  agent_fee_usd           Decimal?            @map("agent_fee_usd") @db.Decimal(14, 2)
  company_fee_usd         Decimal?            @map("company_fee_usd") @db.Decimal(14, 2)
  gross_commission_usd    Decimal?            @map("gross_commission_usd") @db.Decimal(14, 2)
  status                  String              @default("draft") // "draft" | "submitted" | "approved" | "rejected" | "closed"
  contract_signed         DateTime?           @map("contract_signed")
  contract_closed         DateTime?           @map("contract_closed")
  documents               Document[]
  commission_payments     CommissionPayment[]
  created_at              DateTime            @default(now()) @map("created_at")
  updated_at              DateTime            @updatedAt @map("updated_at")

  @@index([agent_id])
  @@index([status])
  @@map("deals")
}

// ═══════════════════════════════════════════════════════════
// LEAD — Client (buyer/tenant/seller/landlord)
// ═══════════════════════════════════════════════════════════
model Lead {
  id                      BigInt                @id @default(autoincrement())
  first_name              String                @map("first_name")
  last_name               String                @map("last_name")
  email                   String                @unique
  phone                   String
  roles                   String[] // ["buyer","renter","seller","landlord"]
  status                  String                @default("new") // new, contacted, active, closed
  portal_role             String?               @map("portal_role") // "buyer" | "tenant" | "seller" | "landlord" — LEGACY, kept for compat
  primary_portal_role     String?               @map("primary_portal_role") // default landing workspace ("seller"|"buyer"|"landlord"|"tenant")
  enabled_workspaces      String[]              @default([]) @map("enabled_workspaces") // ["seller","buyer","landlord","tenant"] — portals this lead can access
  portal_token            String?               @unique @map("portal_token") // SHA-256 hash of invite token
  portal_token_expires_at DateTime?             @map("portal_token_expires_at") // TTL for invite token (72h)
  password_hash           String?               @map("password_hash") // for portal login
  email_verified_at       DateTime?             @map("email_verified_at") // null = unverified (self-signup). Set by invite acceptance or email verification.
  email_verify_token      String?               @map("email_verify_token") // 6-digit OTP for self-signup verification
  email_verify_expires    DateTime?             @map("email_verify_expires") // Token expiry (15 min)
  agent_id                BigInt?               @map("agent_id")
  agent                   Agent?                @relation(fields: [agent_id], references: [id])
  source                  String                @default("website") // website, referral, manual
  anonymous_session_id    String?               @map("anonymous_session_id") // links pre-identification behavioral events
  consent_captured_at     DateTime?             @map("consent_captured_at") // TCPA/CAN-SPAM consent timestamp
  attorney_name           String?               @map("attorney_name") // Seller's attorney name
  attorney_email          String?               @map("attorney_email") // Seller's attorney email
  attorney_phone          String?               @map("attorney_phone") // Seller's attorney phone
  attorney_firm           String?               @map("attorney_firm") // Attorney's firm name
  notes                   String?               @db.Text // Free-form notes
  lease_end_date          DateTime?             @map("lease_end_date") // For renters: when current lease expires
  lease_start_date        DateTime?             @map("lease_start_date") // For renters: when current lease started
  annual_income           Decimal?              @map("annual_income") @db.Decimal(14, 2) // Financial qualification
  bonuses                 Decimal?              @db.Decimal(14, 2) // Annual bonuses
  credit_score_range      String?               @map("credit_score_range") // excellent/good/fair/poor
  pre_approved            Boolean               @default(false) @map("pre_approved") // Mortgage pre-approval
  pre_approved_amount     Decimal?              @map("pre_approved_amount") @db.Decimal(14, 2)
  down_payment            Decimal?              @map("down_payment") @db.Decimal(14, 2)
  available_funds         Decimal?              @map("available_funds") @db.Decimal(14, 2) // Deposit / liquid assets
  monthly_debt            Decimal?              @map("monthly_debt") @db.Decimal(14, 2) // Monthly debt payments
  employer                String? // Employer name
  work_title              String?               @map("work_title") // Job title
  rent_per_month          Decimal?              @map("rent_per_month") @db.Decimal(14, 2) // Renter: current monthly rent
  rental_deposit          Decimal?              @map("rental_deposit") @db.Decimal(14, 2) // Renter: deposit paid
  total_monthly_expense   Decimal?              @map("total_monthly_expense") @db.Decimal(14, 2) // Buyer: total monthly (mortgage+maint+tax)
  pipeline_stage          String                @default("new") @map("pipeline_stage") // new/contacted/nurturing/prospect/active_seller/active_buyer/active_landlord/active_renter/showing/offer/deal/viewed_not_rent/current_tenant/closed/past
  last_contacted_at       DateTime?             @map("last_contacted_at")
  next_follow_up          DateTime?             @map("next_follow_up")
  follow_up_tasks         FollowUpTask[]
  activity_logs           ActivityLog[]
  preferences             ClientPreference?
  actions                 ClientListingAction[]
  showings                Showing[]
  saved_searches          SavedSearch[]
  comments                Comment[]
  inquiries               Inquiry[]
  family_members          FamilyMember[]
  family_of               FamilyMember[]        @relation("FamilyOf")
  external_listings       ExternalListing[]     @relation("LeadExternalListings")
  submitted_external_listings ExternalListing[] @relation("SubmittedExternalListings")
  external_listing_comments ExternalListingComment[]
  intent_events           IntentEvent[]
  intent_profile          BuyerIntentProfile?
  lead_score              LeadScore?
  showing_feedback        ShowingFeedback[]
  // --- Secondary person (spouse, partner, co-buyer, co-owner, roommate) ---
  secondary_first_name    String?               @map("secondary_first_name")
  secondary_last_name     String?               @map("secondary_last_name")
  secondary_email         String?               @map("secondary_email")
  secondary_phone         String?               @map("secondary_phone")
  secondary_relationship  String?               @map("secondary_relationship") // "spouse" | "partner" | "co-buyer" | "roommate" | "co-owner" | "parent" | "other"

  // --- Addresses (landlords: property + home; renters: current; sellers: listing + home) ---
  property_address     String? @map("property_address") // The unit being rented/sold
  home_address         String? @map("home_address") // Owner's personal address
  unit_number          String? @map("unit_number")
  legal_ownership_name String? @map("legal_ownership_name") // LLC, Trust, individual name

  buyer_rep_agreement      Boolean   @default(false) @map("buyer_rep_agreement") // UCBA E7: buyer rep agreement on file
  buyer_rep_agreement_date DateTime? @map("buyer_rep_agreement_date") // Date agreement was signed

  // --- Contact behavior tracking (on the listing, not email) ---
  last_login_at          DateTime? @map("last_login_at")
  login_count            Int       @default(0) @map("login_count")
  last_response_at       DateTime? @map("last_response_at")
  last_click_at          DateTime? @map("last_click_at")
  last_viewed_listing_id String?   @map("last_viewed_listing_id")
  last_viewed_listing_at DateTime? @map("last_viewed_listing_at")

  // --- Listing relationship ---
  active_sale_listing_id   String? @map("active_sale_listing_id")
  active_rental_listing_id String? @map("active_rental_listing_id")

  // --- Financial profile (all client types — especially tenants/renters) ---
  // Used to flag high-net-worth individuals for sales pursuit
  net_worth_estimate       Decimal? @map("net_worth_estimate") @db.Decimal(16, 2)
  net_worth_source         String?  @map("net_worth_source") // "stated" | "verified" | "estimated"
  liquid_assets_total      Decimal? @map("liquid_assets_total") @db.Decimal(16, 2) // total liquid (cash + investments)
  investment_properties    Int?     @default(0) @map("investment_properties") // # of properties owned
  portfolio_value_estimate Decimal? @map("portfolio_value_estimate") @db.Decimal(16, 2) // total real estate portfolio value
  is_high_net_worth        Boolean  @default(false) @map("is_high_net_worth") // flagged for priority sales pursuit
  hnw_pursuit_level        String?  @map("hnw_pursuit_level") // "standard" | "active" | "priority"
  hnw_notes                String?  @map("hnw_notes") // notes on why flagged, what they own

  // --- Investor fields ---
  is_investor            Boolean   @default(false) @map("is_investor")
  investment_strategy    String?   @map("investment_strategy") // "cash_flow" | "appreciation" | "value_add" | "1031_exchange"
  cap_rate_target        Decimal?  @map("cap_rate_target") @db.Decimal(5, 2)
  cash_on_cash_target    Decimal?  @map("cash_on_cash_target") @db.Decimal(5, 2)
  holding_period_years   Int?      @map("holding_period_years")
  exchange_1031_status   String?   @map("exchange_1031_status") // "none" | "identifying" | "exchanging" | "completed"
  exchange_1031_deadline DateTime? @map("exchange_1031_deadline")
  current_portfolio      Json?     @map("current_portfolio")

  // --- Seller/landlord fields ---
  seller_potential        String?   @default("none") @map("seller_potential") // "none" | "low" | "medium" | "high"
  seller_potential_reason String[]  @map("seller_potential_reason")
  vacancy_risk            String?   @map("vacancy_risk") // "low" | "medium" | "high"
  relist_reminder_date    DateTime? @map("relist_reminder_date")

  // --- Renter fields ---
  no_fee_only               Boolean   @default(false) @map("no_fee_only")
  exclusive_acceptable      Boolean   @default(true) @map("exclusive_acceptable")
  building_type_pref        String[]  @map("building_type_pref") // ["condo", "coop", "condop", "rental"]
  guarantor_needed          Boolean   @default(false) @map("guarantor_needed")
  docs_readiness            Json?     @map("docs_readiness") // { pay_stubs: true, tax_returns: false, ... }
  // Tenant origin + fee situation
  tenant_origin             String?   @map("tenant_origin") // "local" | "out_of_state" | "international" | "relocation"
  relocation_company        String?   @map("relocation_company") // if relocation, who is paying
  fee_tolerance             String?   @map("fee_tolerance") // "no_fee_only" | "owner_pay_only" | "will_pay_fee" | "relocation_pays"
  is_international          Boolean   @default(false) @map("is_international") // international tenant (needs guarantor or 40x income)
  guarantor_type            String?   @map("guarantor_type") // "personal" | "third_party" (Insurent/TheGuarantors) | "none"
  guarantor_name            String?   @map("guarantor_name")
  guarantor_company         String?   @map("guarantor_company") // Insurent, TheGuarantors, etc.
  understands_board_process Boolean   @default(false) @map("understands_board_process")
  income_multiple           Decimal?  @map("income_multiple") @db.Decimal(5, 1) // annual income / annual rent (40x = standard NYC)
  move_in_date              DateTime? @map("move_in_date") // desired move-in date
  move_in_flexibility       String?   @map("move_in_flexibility") // "exact" | "flexible_1wk" | "flexible_1mo"

  // --- Viewed/did-not-rent tracking ---
  viewed_addresses Json? @map("viewed_addresses")
  buyer_potential  Int?  @default(0) @map("buyer_potential") // 0-100

  // --- Outreach dates (real DB fields, sortable) ---
  outreach_6mo_date DateTime? @map("outreach_6mo_date")
  outreach_90d_date DateTime? @map("outreach_90d_date")
  outreach_60d_date DateTime? @map("outreach_60d_date")
  outreach_30d_date DateTime? @map("outreach_30d_date")

  // --- Drip/automation state ---
  sales_drip_on            Boolean   @default(false) @map("sales_drip_on")
  rental_drip_on           Boolean   @default(false) @map("rental_drip_on")
  renewal_drip_on          Boolean   @default(false) @map("renewal_drip_on")
  sales_drip_status        String?   @map("sales_drip_status") // "active" | "monthly" | "quarterly" | "biannual" | "paused"
  rental_drip_status       String?   @map("rental_drip_status")
  last_sales_email_opened  DateTime? @map("last_sales_email_opened")
  last_rental_email_opened DateTime? @map("last_rental_email_opened")
  last_unsubscribe_at      DateTime? @map("last_unsubscribe_at")
  preferred_channel        String?   @map("preferred_channel") // "portal" | "email" | "text" | "phone" — derived from behavior
  preferred_device         String?   @map("preferred_device") // "mobile" | "desktop" — derived from listing views
  nurture_paused           Boolean   @default(false) @map("nurture_paused")

  // --- Rental timeline ---
  renewal_status       String?   @map("renewal_status") // "pending" | "renewing" | "not_renewing" | "month_to_month"
  non_renewal_date     DateTime? @map("non_renewal_date")
  reengage_anchor_date DateTime? @map("reengage_anchor_date")

  // --- Showing date tracking ---
  first_shown_date DateTime? @map("first_shown_date") // First showing date for this lead
  last_shown_date  DateTime? @map("last_shown_date") // Most recent showing date

  // --- Promotion tracking (cross-CRM routing) ---
  promoted_to_buyer_at      DateTime? @map("promoted_to_buyer_at")
  promoted_to_seller_at     DateTime? @map("promoted_to_seller_at")
  promoted_from_landlord_at DateTime? @map("promoted_from_landlord_at")
  promoted_from_tenant_at   DateTime? @map("promoted_from_tenant_at")
  promotion_source          String?   @map("promotion_source") // "landlord" | "tenant" | "renter" | "viewer"
  promotion_reason          String?   @map("promotion_reason") // free text reason for promotion

  // --- Entity ownership (LLC, Trust, Corp, Inc) ---
  entity_name            String?     @map("entity_name")
  entity_type            String?     @map("entity_type") // "individual" | "llc" | "trust" | "corp" | "inc" | "lp" | "lllp"
  entity_ein             String?     @map("entity_ein") // EIN / Tax ID
  entity_state           String?     @map("entity_state") // State of formation (NY, DE, etc.)
  entity_managing_member String?     @map("entity_managing_member") // Name of managing member / trustee / president
  entity_formation_date  DateTime?   @map("entity_formation_date") // Date entity was formed
  authorized_signatories Json?       @map("authorized_signatories") // LEGACY: [{ name, title, email, phone }] — superseded by LeadParty
  lead_parties           LeadParty[] // All parties on this transaction

  // --- Buyer closing cost estimates (for Move-In Cost Calculator) ---
  // Mortgage
  mortgage_rate           Decimal?  @map("mortgage_rate") @db.Decimal(5, 3) // Locked rate %
  mortgage_term_years     Int?      @map("mortgage_term_years") // 30, 20, 15
  mortgage_lender         String?   @map("mortgage_lender")
  mortgage_broker_name    String?   @map("mortgage_broker_name")
  mortgage_broker_email   String?   @map("mortgage_broker_email")
  mortgage_broker_phone   String?   @map("mortgage_broker_phone")
  // Buyer closing cost estimates
  mansion_tax_estimate    Decimal?  @map("mansion_tax_estimate") @db.Decimal(14, 2) // Buyer pays (1%-3.9%)
  mortgage_recording_tax  Decimal?  @map("mortgage_recording_tax") @db.Decimal(14, 2) // ~1.8% of loan (<$500K) or 1.925%
  title_insurance         Decimal?  @map("title_insurance") @db.Decimal(14, 2)
  attorney_fee_buyer      Decimal?  @map("attorney_fee_buyer") @db.Decimal(14, 2)
  board_app_fee           Decimal?  @map("board_app_fee") @db.Decimal(14, 2) // Co-op/condo board application fee
  move_in_fee             Decimal?  @map("move_in_fee") @db.Decimal(14, 2) // Building move-in fee
  // Buyer agent fee (NAR settlement — negotiated, never pre-set)
  buyer_agent_fee_pct     Decimal?  @map("buyer_agent_fee_pct") @db.Decimal(5, 2) // % (negotiable, must be in buyer rep agreement)
  buyer_agent_fee_note    String?   @map("buyer_agent_fee_note") // "As per buyer rep agreement — fully negotiable"
  // Board application status
  board_app_status        String?   @map("board_app_status") // "not_started" | "in_progress" | "submitted" | "interview_scheduled" | "approved" | "rejected"
  board_app_submitted_at  DateTime? @map("board_app_submitted_at")
  board_interview_date    DateTime? @map("board_interview_date")
  board_approved_at       DateTime? @map("board_approved_at")
  board_rejection_reason  String?   @map("board_rejection_reason")
  // Closing
  closing_date            DateTime? @map("closing_date")
  closing_celebrated      Boolean   @default(false) @map("closing_celebrated")
  gift_sent_at            DateTime? @map("gift_sent_at")
  anniversary_6mo_sent_at DateTime? @map("anniversary_6mo_sent_at")
  anniversary_1yr_sent_at DateTime? @map("anniversary_1yr_sent_at")

  // --- Seller intake fields ---
  home_prep_checklist        Json? @map("home_prep_checklist")
  building_mgmt_requirements Json? @map("building_mgmt_requirements")
  disclosures                Json? @map("disclosures")
  documents_collected        Json? @map("documents_collected")
  marketing_strategy         Json? @map("marketing_strategy")

  // --- Landlord intake fields ---
  property_disclosures Json?   @map("property_disclosures")
  lease_terms          Json?   @map("lease_terms")
  fee_structure        String? @map("fee_structure") // "owner_pay" | "tenant_pay" | "no_fee"

  // --- Relations for new models ---
  owned_listings  Listing[]        @relation("ListingOwner")
  showing_history ShowingHistory[]

  portal_events          PortalEvent[]
  listing_views          ListingView[]
  landlord_active_leases ActiveLease[] @relation("LandlordActiveLeases")
  tenant_active_leases   ActiveLease[] @relation("TenantActiveLeases")

  // --- Custom fields (agent-defined, no migration needed) ---
  // Stored as { "Field Name": "value", "Another Field": "value" }
  // Agent adds/removes fields directly from the CRM workspace.
  // Use for any information not covered by the structured fields above.
  custom_fields Json? @map("custom_fields")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([created_at])
  @@index([agent_id])
  @@index([seller_potential])
  @@index([renewal_status])
  @@map("leads")
}

// ═══════════════════════════════════════════════════════════
// LISTING — RLS listing (synced from Trestle or created manually)
// ═══════════════════════════════════════════════════════════
model Listing {
  id              BigInt  @id @default(autoincrement())
  listing_id      String  @unique @map("listing_id") // Trestle ListingId or internal SL-/RL- prefix
  mls_id          String? @map("mls_id")
  agent_id        BigInt? @map("agent_id") // Listing agent (for exclusive listings)
  agent           Agent?  @relation(fields: [agent_id], references: [id])
  owner_client_id BigInt? @map("owner_client_id") // FK to Lead — the seller/landlord who owns this listing
  owner_client    Lead?   @relation("ListingOwner", fields: [owner_client_id], references: [id])

  // --- Filter columns (indexed for queries) ---
  status            String   @default("Active") // Cotality StandardStatus
  listing_type      String   @map("listing_type") // "sale" | "rent"
  property_type     String?  @map("property_type") // Cotality PropertyType
  property_sub_type String?  @map("property_sub_type")
  list_price        Decimal  @map("list_price") @db.Decimal(14, 2)
  bedrooms_total    Int?     @map("bedrooms_total")
  bathrooms_full    Int?     @map("bathrooms_full")
  bathrooms_half    Int?     @map("bathrooms_half")
  living_area       Decimal? @map("living_area") @db.Decimal(10, 2)
  borough           String?
  neighborhood      String?
  city              String?
  postal_code       String?  @map("postal_code")

  // --- RLS eligibility ---
  rls_eligible         Boolean @default(true) @map("rls_eligible") // false = website-only (commercial, off-RLS)
  commercial_sub_type  String? @map("commercial_sub_type") // e.g. "RetailStore", "OfficeSpace", "Restaurant"
  commercial_ownership String? @map("commercial_ownership") // e.g. "CommercialCondo", "CommercialCoop"

  // --- Distribution gates (6 REBNY RLS gates) ---
  idx_display_yn                          Boolean @default(true) @map("idx_display_yn")
  internet_entire_listing_display_yn      Boolean @default(true) @map("internet_entire_listing_display_yn")
  internet_address_display_yn             Boolean @default(true) @map("internet_address_display_yn")
  internet_automated_valuation_display_yn Boolean @default(true) @map("internet_automated_valuation_display_yn")
  internet_consumer_comment_yn            Boolean @default(true) @map("internet_consumer_comment_yn")
  participant_only                        Boolean @default(false) @map("participant_only")
  owner_opt_out                           Boolean @default(false) @map("owner_opt_out")

  // --- JSON columns (nested/variable data) ---
  address    Json  @default("{}")
  features   Json  @default("{}")
  media      Json  @default("[]")
  compliance Json  @default("{}")
  // agent_info REMOVED from the Prisma schema/client in Phase D step 3 (board #415). The typed
  // agent columns below are the source of truth (A6 proved typed_gap_rows = 0; runtime + ops
  // `agent_info: true` selects removed in #426/#427). Dropping the model field makes Prisma stop
  // selecting it on EVERY read — including implicit no-`select` findUnique/findMany and
  // `include: { listing }`. The PHYSICAL DB column still EXISTS (intentional, temporary schema↔DB
  // drift); the DB `ALTER TABLE listings DROP COLUMN agent_info` is a SEPARATE, snapshot-gated,
  // explicitly-Maya-approved step that must follow a successful deploy of this change.
  raw_data   Json? @map("raw_data")

  // --- Media normalization (master refactor PR 2 — memory/REFACTOR-2026-04-25.md) ---
  // Promoted from `media` JSON for fast card render without JSON traversal.
  // ALL nullable per NEON.md §4: never `NOT NULL DEFAULT ...` on a populated
  // table. Populated incrementally by lib/idx/media-sync.ts (PR 3).
  // Readers continue to use the `media` JSON column until PR 4 swaps them.
  primary_photo_url       String?   @map("primary_photo_url")
  primary_photo_r2_key    String?   @map("primary_photo_r2_key")
  photos_change_timestamp DateTime? @map("photos_change_timestamp")
  photo_count             Int?      @map("photo_count")

  // --- Agent attribution typed columns (agent_info JSON-drop) ---
  // Phase A.5 (2026-05-10) promoted the 2 display keys (list_agent_full_name,
  // list_office_name). The 2026-06-18 normalization spec (#410) extends this to
  // ALL 8 read keys so the `agent_info` JSON can be dropped (Phase D). The 6 columns
  // added 2026-06-18 (Phase A1) complete the typed set.
  //
  // PII boundary (spec §4, fail-closed): list_agent_email + list_agent_direct_phone
  // are PRIVATE/internal — having a typed column does NOT make them render. The
  // DTO/portal-mask layer still gates exposure: office/name on public; agent PII only
  // on the exclusive contact card + authenticated CRM; buyer/tenant portal masked
  // fail-closed. The MLS-ID columns feed syndication eligibility GATES, not display.
  //
  // ALL nullable per NEON.md §4 (additive on populated table). No NOT NULL DEFAULT.
  // Backfilled separately from `agent_info` JSON during a 3-5am ET window (NOT in the
  // migration). Readers keep using the JSON column until Phase B swaps them via
  // `resolveListingAgentInfo` (typed-first / JSON-fallback). Full plan:
  // docs/superpowers/plans/2026-06-18-agent-info-normalization.md.
  list_agent_full_name    String? @map("list_agent_full_name")
  list_office_name        String? @map("list_office_name")
  list_agent_email        String? @map("list_agent_email") // PRIVATE — gated by DTO/mask layer
  list_agent_direct_phone String? @map("list_agent_direct_phone") // PRIVATE — gated by DTO/mask layer
  list_office_mls_id      String? @map("list_office_mls_id")
  list_agent_mls_id       String? @map("list_agent_mls_id")
  co_list_office_mls_id   String? @map("co_list_office_mls_id")
  co_list_agent_mls_id    String? @map("co_list_agent_mls_id")


  // --- Auction listing fields (UCBA Art. I exception path — Workstream C3) ---
  // Closes C15 [low] in compliance/rules/ucba-audit-checklist.json:
  //   "Auction Listing Requirements — Must include: minimum bid, date/time/
  //    location, registration, inspection, buyer's premium"
  // All nullable per NEON.md §4. Enforcement (auction_type +
  // auction_end_date mandatory when auction_yn=true) lives in
  // lib/compliance/rls-enforcement.ts.
  auction_yn         Boolean?  @map("auction_yn") // true if listing is being sold via auction
  auction_type       String?   @map("auction_type") // "Absolute" | "WithReserve" | "Minimum"
  auction_start_date DateTime? @map("auction_start_date")
  auction_end_date   DateTime? @map("auction_end_date") // bidding-ends timestamp
  auction_terms_url  String?   @map("auction_terms_url") // public auction terms doc

  // --- Relations ---
  actions                   ClientListingAction[]
  showings                  Showing[]
  comments                  Comment[]
  inquiries                 Inquiry[]
  offers                    Offer[]
  price_history             PriceHistory[]
  marketing_activities      MarketingActivity[]
  listing_media             ListingMedia[]
  listing_search_projection ListingSearchProjection?
  // B1b-1 canonical identity (additive; virtual OPTIONAL SINGULAR (1:1) back-relation
  // — NO column/SQL change on `listings`). At most one identity row per listing
  // (unique `listing_identity.listing_id`); existing listings have none until the B1b
  // writer is enabled. The FK lives on `listing_identity`. NOT WIRED to any reader.
  listing_identity          ListingIdentity?

  // --- DOM tracking (UCBA 2026: 30-day reset) ---
  status_changed_at         DateTime? @map("status_changed_at")
  first_active_date         DateTime? @map("first_active_date")
  // --- Archive eligibility clock (#415) — stable terminal-age date, set once on
  // non-terminal→terminal transition from a stable source date (CloseDate/
  // OffMarketDate); NOT re-stamped by idx-sync like status_changed_at/modification_timestamp.
  terminal_since            DateTime? @map("terminal_since")
  days_on_market            Int       @default(0) @map("days_on_market")
  cumulative_days_on_market Int       @default(0) @map("cumulative_days_on_market")

  // --- Protected Period (UCBA A6/A7/A8) ---
  expiration_date         DateTime?        @map("expiration_date") // Exclusive agreement expiration (promoted from raw_data)
  expiration_30d_notified Boolean          @default(false) @map("expiration_30d_notified")
  expiration_7d_notified  Boolean          @default(false) @map("expiration_7d_notified")
  protected_period        ProtectedPeriod?

  // --- Sync tracking (Trestle IDX pipeline) ---
  last_synced_from_trestle DateTime? @map("last_synced_from_trestle")
  sync_status              String?   @default("pending") @map("sync_status") // "pending" | "synced" | "gated:*" | "error"

  // --- Timestamps ---
  modification_timestamp DateTime  @map("modification_timestamp")
  listing_contract_date  DateTime? @map("listing_contract_date")
  created_at             DateTime  @default(now()) @map("created_at")
  updated_at             DateTime  @updatedAt @map("updated_at")
  // Agent-defined custom fields — no migration needed to add new data
  custom_fields          Json?     @map("custom_fields")

  // Comp criteria — agent-adjustable filters for building + area comps
  // Structure: { building: { beds_min, beds_max, baths_min, baths_max, sqft_min, sqft_max, sqft_enabled, statuses[], months_back },
  //              area: { ...same + price_min, price_max, neighborhoods[] } }
  comp_criteria Json? @map("comp_criteria")

  @@index([status, listing_type])
  @@index([list_price])
  @@index([borough, neighborhood])
  @@index([rls_eligible])
  @@index([bedrooms_total])
  @@index([modification_timestamp])
  @@index([agent_id])
  @@index([owner_client_id])
  // DATAMODEL RECONCILIATION (2026-08-19): this index is created by the applied baseline migration
  // (prisma/migrations/20260301073253_baseline/migration.sql:247) and exists in production with
  // 42,645 scans, but was missing from this datamodel — so `migrate diff` proposed DROPping it.
  // Declaring it produces no SQL; it reconciles the model with migration history and production.
  @@index([idx_display_yn, owner_opt_out], map: "listings_idx_display_yn_owner_opt_out_idx")
  // P1 search-index pack (#415 Neon/Search Foundation). Additive only.
  // Neighborhood search resolves to `postal_code IN(...)` (public-listing-db.ts) — read-only
  // EXPLAIN (2026-06-24) proved postal_code was an unindexed post-bitmap Filter (~6062 cost).
  // (Interim: PR 5B's listing_search_projection already has postal_code; drop post-swap to
  // reclaim.) Gate composite intentionally NOT added — EXPLAIN showed existing BitmapAnd
  // (status idx + idx_display/owner idx) already covers the gate (marginal + PR-5B supersedes).
  @@index([postal_code], map: "listings_postal_code_idx")
  // Archive eligibility clock (#415). Indexes the future T+180 archive predicate
  // (terminal_since < cutoff). Additive; PR-2 repoints the predicate to it.
  @@index([terminal_since], map: "listings_terminal_since_idx")
  @@map("listings")
}

// ═══════════════════════════════════════════════════════════
// SESSION — Server-side session store
// ═══════════════════════════════════════════════════════════
model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  user_type  String   @map("user_type") // "agent" | "lead"
  user_id    BigInt   @map("user_id")
  role       String // "BROKER" | "AGENT" | "buyer" | "tenant" | "seller" | "landlord"
  expires_at DateTime @map("expires_at")
  created_at DateTime @default(now()) @map("created_at")
  ip_address String?  @map("ip_address")
  user_agent String?  @map("user_agent") @db.Text

  @@index([token])
  @@index([user_type, user_id])
  @@index([expires_at])
  @@map("sessions")
}

// ═══════════════════════════════════════════════════════════
// MFA SESSION — Short-lived pending session for OTP verification
// ═══════════════════════════════════════════════════════════
model MfaSession {
  id         String   @id @default(cuid())
  token      String   @unique
  agent_id   BigInt   @map("agent_id")
  code_hash  String   @map("code_hash") // bcrypt hash of 6-digit OTP
  attempts   Int      @default(0) // rate limit: max 5
  expires_at DateTime @map("expires_at")
  created_at DateTime @default(now()) @map("created_at")
  ip_address String?  @map("ip_address")
  user_agent String?  @map("user_agent") @db.Text

  @@index([token])
  @@index([expires_at])
  @@map("mfa_sessions")
}

// ═══════════════════════════════════════════════════════════
// SYNC STATE — Trestle delta-sync watermark (one row per resource)
// Replaces fragile MAX(last_synced_from_trestle) with an atomic watermark.
// ═══════════════════════════════════════════════════════════
model SyncState {
  resource             String    @id // "Property" | "Media" | "Member" | "Office"
  last_watermark       DateTime? @map("last_watermark") // last ModificationTimestamp processed
  // Keyset tie-breaker: the ListingKey of the last fully-processed record AT
  // `last_watermark`. Enables same-timestamp continuation
  // `(MT = ts AND ListingKey > last_listing_key)` under ASC ordering, which a
  // scalar `MT gt ts` cursor cannot express. Required because timestamp
  // clustering exceeds the 500-record scheduled cap: production carries a
  // 797-row cluster at one ModificationTimestamp (2026-04-24T03:30:26.372Z),
  // where a scalar cursor either re-reads the same page forever or skips 297
  // rows. Mirrors `media_sync_state.last_listing_key`, which already does this
  // for the PhotosChangeTimestamp dimension.
  // Nullable — null means "no tie-breaker yet", i.e. legacy/first run.
  last_listing_key     String?   @map("last_listing_key")
  last_run_at          DateTime? @map("last_run_at")
  last_run_status      String?   @map("last_run_status") // "ok" | "error" | "partial"
  last_run_duration_ms Int?      @map("last_run_duration_ms")
  rows_upserted        Int?      @map("rows_upserted")
  rows_skipped_by_gate Int?      @map("rows_skipped_by_gate")
  rows_with_errors     Int?      @map("rows_with_errors")
  notes                String?

  @@map("sync_state")
}

// ═══════════════════════════════════════════════════════════
// SYNC ERROR — Structured per-record sync failures
// Replaces unstructured console.error + bulk audit entries.
// ═══════════════════════════════════════════════════════════
model SyncError {
  id          BigInt    @id @default(autoincrement())
  resource    String // "Property" | "Media" | "Member" | "Office"
  listing_key String?   @map("listing_key") // Trestle ListingKey if applicable
  listing_id  String?   @map("listing_id") // Trestle ListingId if applicable
  error_code  String?   @map("error_code") // short code e.g. "validation", "gate", "upsert"
  error_msg   String    @map("error_msg") @db.VarChar(2000)
  attempt_num Int       @default(1) @map("attempt_num")
  raw_payload Json?     @map("raw_payload") // snippet of the offending record for debug
  occurred_at DateTime  @default(now()) @map("occurred_at")
  resolved_at DateTime? @map("resolved_at")

  @@index([resource, occurred_at])
  @@index([listing_key])
  @@index([error_code])
  @@map("sync_errors")
}

// ═══════════════════════════════════════════════════════════
// LISTINGS ARCHIVE — Minimal past-sales / historical data
// Populated by Phase 4 lifecycle cron for terminal listings >180d.
// Kept for 6 years per NY DOS recordkeeping requirements.
// ═══════════════════════════════════════════════════════════
model ListingsArchive {
  id                   BigInt    @id @default(autoincrement())
  listing_key          String    @unique @map("listing_key") // Trestle ListingKey
  listing_id           String?   @map("listing_id") // legacy listing_id for cross-reference
  mls_id               String?   @map("mls_id")
  status               String // terminal only: Closed | Sold | Leased | Rented
  listing_type         String    @map("listing_type")
  property_type        String?   @map("property_type")
  property_sub_type    String?   @map("property_sub_type")
  close_price          Decimal?  @map("close_price") @db.Decimal(14, 2)
  close_date           DateTime? @map("close_date")
  list_price           Decimal?  @map("list_price") @db.Decimal(14, 2)
  original_list_price  Decimal?  @map("original_list_price") @db.Decimal(14, 2)
  bedrooms_total       Int?      @map("bedrooms_total")
  bathrooms_full       Int?      @map("bathrooms_full")
  bathrooms_half       Int?      @map("bathrooms_half")
  living_area          Decimal?  @map("living_area") @db.Decimal(10, 2)
  borough              String?
  neighborhood         String?
  city                 String?
  postal_code          String?   @map("postal_code")
  address_line         String?   @map("address_line") // denormalized for past-sales display
  list_agent_full_name String?   @map("list_agent_full_name")
  list_office_name     String?   @map("list_office_name")
  days_on_market       Int?      @map("days_on_market")
  original_created_at  DateTime? @map("original_created_at") // when listing was first created
  archived_at          DateTime  @default(now()) @map("archived_at")

  @@index([close_date])
  @@index([neighborhood, close_date])
  @@index([borough, close_date])
  @@index([list_agent_full_name])
  @@map("listings_archive")
}

// ═══════════════════════════════════════════════════════════
// AUDIT EVENT — Immutable log of all data mutations
// ═══════════════════════════════════════════════════════════
model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  action      String // "create" | "update" | "delete" | "status_change" | "login" | "logout"
  entity_type String   @map("entity_type") // "listing" | "deal" | "lead" | "agent" | "session"
  entity_id   String   @map("entity_id") // ID of the affected record
  user_type   String   @map("user_type") // "agent" | "lead" | "system"
  user_id     BigInt?  @map("user_id")
  changes     Json? // { field: { old, new } } diff
  ip_address  String?  @map("ip_address")
  created_at  DateTime @default(now()) @map("created_at")

  @@index([entity_type, entity_id])
  @@index([user_type, user_id])
  @@index([created_at])
  @@map("audit_events")
}

// ═══════════════════════════════════════════════════════════
// CLIENT PREFERENCE — Buyer/tenant search criteria
// ═══════════════════════════════════════════════════════════
model ClientPreference {
  id             BigInt    @id @default(autoincrement())
  lead_id        BigInt    @unique @map("lead_id")
  lead           Lead      @relation(fields: [lead_id], references: [id])
  property_types String[]  @map("property_types")
  neighborhoods  String[]
  boroughs       String[]
  min_beds       Int?      @map("min_beds")
  max_beds       Int?      @map("max_beds")
  min_baths      Int?      @map("min_baths")
  max_baths      Int?      @map("max_baths")
  min_price      Decimal?  @map("min_price") @db.Decimal(14, 2)
  max_price      Decimal?  @map("max_price") @db.Decimal(14, 2)
  min_sqft       Int?      @map("min_sqft")
  must_haves     String[]  @map("must_haves")
  deal_breakers  String[]  @map("deal_breakers")
  move_in_date   DateTime? @map("move_in_date")
  notes          String?   @db.Text
  created_at     DateTime  @default(now()) @map("created_at")
  updated_at     DateTime  @updatedAt @map("updated_at")

  @@index([lead_id])
  @@map("client_preferences")
}

// ═══════════════════════════════════════════════════════════
// CLIENT LISTING ACTION — Reactions (liked, disliked, discuss, etc.)
// ═══════════════════════════════════════════════════════════
model ClientListingAction {
  id         BigInt   @id @default(autoincrement())
  lead_id    BigInt   @map("lead_id")
  lead       Lead     @relation(fields: [lead_id], references: [id])
  listing_id BigInt   @map("listing_id")
  listing    Listing  @relation(fields: [listing_id], references: [id])
  action     String // "liked" | "disliked" | "discuss" | "schedule" | "offer"
  comment    String?  @db.Text
  created_at DateTime @default(now()) @map("created_at")

  @@unique([lead_id, listing_id, action])
  @@index([lead_id])
  @@index([listing_id])
  @@map("client_listing_actions")
}

// ═══════════════════════════════════════════════════════════
// LISTING VIEW — Tracked listing link views (engagement data)
// ═══════════════════════════════════════════════════════════
// ExternalListing stores buyer-submitted non-IDX links/addresses separately
// from MLS/IDX Listing rows.
model ExternalListing {
  id                   BigInt    @id @default(autoincrement())
  lead_id              BigInt    @map("lead_id")
  lead                 Lead      @relation("LeadExternalListings", fields: [lead_id], references: [id], onDelete: Cascade)
  submitted_by_lead_id BigInt?   @map("submitted_by_lead_id")
  submitted_by         Lead?     @relation("SubmittedExternalListings", fields: [submitted_by_lead_id], references: [id], onDelete: SetNull)
  agent_id             BigInt?   @map("agent_id")
  agent                Agent?    @relation(fields: [agent_id], references: [id], onDelete: SetNull)
  url                  String?   @db.VarChar(2048)
  normalized_url       String?   @map("normalized_url") @db.VarChar(2048)
  source_host          String?   @map("source_host") @db.VarChar(255)
  address              String?   @db.VarChar(500)
  title                String?   @db.VarChar(255)
  notes                String?   @db.Text
  status               String    @default("submitted")
  action_bucket        String    @default("saved") @map("action_bucket")
  family_visible       Boolean   @default(false) @map("family_visible")
  comments             ExternalListingComment[]
  created_at           DateTime  @default(now()) @map("created_at")
  updated_at           DateTime  @updatedAt @map("updated_at")

  @@unique([lead_id, normalized_url])
  @@index([lead_id])
  @@index([agent_id])
  @@index([submitted_by_lead_id])
  @@index([status])
  @@index([action_bucket])
  @@index([lead_id, family_visible])
  @@map("external_listings")
}

model ExternalListingComment {
  id                  BigInt          @id @default(autoincrement())
  external_listing_id BigInt          @map("external_listing_id")
  external_listing    ExternalListing @relation(fields: [external_listing_id], references: [id], onDelete: Cascade)
  lead_id             BigInt?         @map("lead_id")
  lead                Lead?           @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  agent_id            BigInt?         @map("agent_id")
  agent               Agent?          @relation(fields: [agent_id], references: [id], onDelete: SetNull)
  body                String          @db.Text
  request_type        String          @default("comment") @map("request_type")
  created_at          DateTime        @default(now()) @map("created_at")
  updated_at          DateTime        @updatedAt @map("updated_at")

  @@index([external_listing_id])
  @@index([lead_id])
  @@index([agent_id])
  @@index([request_type])
  @@map("external_listing_comments")
}

model ListingView {
  id          BigInt   @id @default(autoincrement())
  lead_id     BigInt   @map("lead_id")
  listing_id  String   @map("listing_id") // String FK matching PortalEvent/DemandSignalEvent pattern
  viewed_at   DateTime @default(now()) @map("viewed_at")
  device_type String?  @map("device_type") // "mobile" | "desktop" | "tablet"
  ip_hash     String?  @map("ip_hash") // SHA-256(IP + TRACKING_SECRET) for unique viewer counting
  referrer    String? // where the click came from

  lead Lead @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id, listing_id])
  @@index([listing_id])
  @@index([lead_id, viewed_at])
  @@map("listing_views")
}

// ═══════════════════════════════════════════════════════════
// SHOWING — Property showing/tour
// ═══════════════════════════════════════════════════════════
model Showing {
  id         BigInt           @id @default(autoincrement())
  lead_id    BigInt?          @map("lead_id")
  lead       Lead?            @relation(fields: [lead_id], references: [id])
  listing_id BigInt           @map("listing_id")
  listing    Listing          @relation(fields: [listing_id], references: [id])
  agent_id   BigInt           @map("agent_id")
  agent      Agent            @relation(fields: [agent_id], references: [id])
  date       DateTime
  time       String? // "10:00 AM" — display-only
  type       String           @default("private") // "private" | "openhouse" | "brokersopen" | "virtual"
  status     String           @default("requested") // "requested" | "confirmed" | "completed" | "cancelled"
  notes      String?          @db.Text
  feedback   ShowingFeedback?
  created_at DateTime         @default(now()) @map("created_at")
  updated_at DateTime         @updatedAt @map("updated_at")

  @@index([lead_id])
  @@index([listing_id])
  @@index([agent_id])
  @@index([date])
  // P1 search-index pack (#415). Open-houses query: type='openhouse' (eq) +
  // date>=today (range) + status!='cancelled' (negation) — app/api/open-houses/route.ts.
  // (type, date) serves the eq+range + orderBy date; status-negation is heap-filtered.
  // NOT superseded by PR 5B (open-houses always reads `showings`).
  @@index([type, date], map: "showings_type_date_idx")
  @@map("showings")
}

// ═══════════════════════════════════════════════════════════
// SAVED SEARCH — Persisted search criteria
// ═══════════════════════════════════════════════════════════
model SavedSearch {
  id              BigInt    @id @default(autoincrement())
  lead_id         BigInt?   @map("lead_id")
  lead            Lead?     @relation(fields: [lead_id], references: [id])
  agent_id        BigInt?   @map("agent_id")
  agent           Agent?    @relation(fields: [agent_id], references: [id])
  name            String
  criteria        Json // { type, minPrice, maxPrice, beds, neighborhoods, ... }
  last_run        DateTime? @map("last_run")
  result_count    Int?      @map("result_count")
  alert_frequency String?   @map("alert_frequency") // 'daily' | 'weekly' | null (disabled)
  alert_enabled   Boolean   @default(false) @map("alert_enabled")
  last_alert_sent DateTime? @map("last_alert_sent")
  alert_email     String?   @map("alert_email") // Override email; if null, uses lead/agent email
  created_at      DateTime  @default(now()) @map("created_at")
  updated_at      DateTime  @updatedAt @map("updated_at")

  @@index([lead_id])
  @@index([agent_id])
  @@index([alert_enabled, alert_frequency])
  @@map("saved_searches")
}

// ═══════════════════════════════════════════════════════════
// COMMENT — Threaded comments on listings (clients + family)
// ═══════════════════════════════════════════════════════════
model Comment {
  id         BigInt    @id @default(autoincrement())
  listing_id BigInt    @map("listing_id")
  listing    Listing   @relation(fields: [listing_id], references: [id])
  lead_id    BigInt    @map("lead_id")
  lead       Lead      @relation(fields: [lead_id], references: [id])
  parent_id  BigInt?   @map("parent_id") // null = top-level, set = reply
  parent     Comment?  @relation("CommentReplies", fields: [parent_id], references: [id])
  replies    Comment[] @relation("CommentReplies")
  body       String    @db.Text
  created_at DateTime  @default(now()) @map("created_at")
  updated_at DateTime  @updatedAt @map("updated_at")

  @@index([listing_id])
  @@index([lead_id])
  @@index([parent_id])
  @@map("comments")
}

// ═══════════════════════════════════════════════════════════
// FAMILY MEMBER — Client invites family to follow along
// ═══════════════════════════════════════════════════════════
model FamilyMember {
  id             BigInt   @id @default(autoincrement())
  lead_id        BigInt   @map("lead_id") // The primary client
  lead           Lead     @relation(fields: [lead_id], references: [id])
  member_lead_id BigInt   @map("member_lead_id") // The family member (also a Lead)
  member         Lead     @relation("FamilyOf", fields: [member_lead_id], references: [id])
  relationship   String? // "spouse" | "parent" | "sibling" | "other"
  created_at     DateTime @default(now()) @map("created_at")

  @@unique([lead_id, member_lead_id])
  @@index([lead_id])
  @@index([member_lead_id])
  @@map("family_members")
}

// ═══════════════════════════════════════════════════════════
// LEAD PARTY — All parties on a transaction
//
// Replaces the single secondary_* fields and authorized_signatories JSON.
// Supports unlimited parties per lead: co-buyers, spouses, guarantors,
// LLC members, trustees, family members, observers.
//
// Used for: buyers, sellers, renters, landlords, investors.
// Anyone who needs to appear on the deed, lease, contract, or board package.
// ═══════════════════════════════════════════════════════════
model LeadParty {
  id      BigInt @id @default(autoincrement())
  lead_id BigInt @map("lead_id")
  lead    Lead   @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  // ── Who they are ──────────────────────────────────────────
  first_name String  @map("first_name")
  last_name  String  @map("last_name")
  email      String?
  phone      String?
  address    String? // Their personal address (if different from lead)

  // ── Their role in this transaction ────────────────────────
  // "co_buyer" | "co_renter" | "co_seller" | "co_owner" |
  // "spouse" | "partner" | "parent" | "child" | "family_member" |
  // "guarantor" | "co_signer" | "authorized_signatory" |
  // "trustee" | "managing_member" | "llc_member" |
  // "corporate_officer" | "observer"
  role String @map("role")

  // ── Signing authority ──────────────────────────────────────
  signs_documents  Boolean @default(false) @map("signs_documents")
  // "individually" | "as_trustee" | "as_managing_member" |
  // "as_authorized_signatory" | "as_guarantor" | "as_corporate_officer"
  signing_capacity String? @map("signing_capacity")
  appears_on_deed  Boolean @default(false) @map("appears_on_deed") // On deed/title
  appears_on_lease Boolean @default(false) @map("appears_on_lease") // On lease agreement
  appears_on_board Boolean @default(false) @map("appears_on_board") // On board application

  // ── Entity purchase (buying as LLC / Trust / Corp) ─────────
  is_entity    Boolean @default(false) @map("is_entity")
  // "llc" | "trust" | "corp" | "inc" | "lp" | "lllp"
  entity_type  String? @map("entity_type")
  entity_name  String? @map("entity_name")
  entity_ein   String? @map("entity_ein") // EIN / Tax ID
  entity_state String? @map("entity_state") // State of formation

  // ── Financial qualification (for co-buyers and guarantors) ─
  annual_income      Decimal? @map("annual_income") @db.Decimal(14, 2)
  credit_score_range String?  @map("credit_score_range")
  employer           String?
  work_title         String?  @map("work_title")

  // ── Portal access ──────────────────────────────────────────
  has_portal_access Boolean @default(false) @map("has_portal_access")
  portal_email      String? @map("portal_email") // email for portal login (may differ)

  notes String? @db.Text

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@index([lead_id])
  @@map("lead_parties")
}

// ═══════════════════════════════════════════════════════════
// ACTIVE LEASE — Already-leased/rented units
//
// Separate from Listing (which is an active market listing).
// Tracks existing tenancies: address, tenant, lease terms,
// renewal status, outreach schedule (90/60/30 days before expiry),
// seller conversion outreach (6-month valuation).
//
// One landlord can have many active leases (multi-unit portfolio).
// ═══════════════════════════════════════════════════════════
model ActiveLease {
  id BigInt @id @default(autoincrement())

  // ── Lease status ──────────────────────────────────────────
  // "active"    — currently rented, lease ongoing
  // "historical" — past rental, lease ended (for outreach timing)
  // "pending"   — signed, not yet moved in
  status String @default("active") @map("status")

  // ── The unit ──────────────────────────────────────────────
  address       String  @map("address")
  unit          String? @map("unit")
  borough       String? @map("borough")
  neighborhood  String? @map("neighborhood")
  zip           String? @map("zip")
  building_type String? @map("building_type") // "condo" | "coop" | "condop" | "rental_building" | "townhouse"

  // ── The landlord ──────────────────────────────────────────
  landlord_lead_id BigInt @map("landlord_lead_id")
  landlord         Lead   @relation("LandlordActiveLeases", fields: [landlord_lead_id], references: [id])

  // ── The tenant ────────────────────────────────────────────
  tenant_lead_id BigInt? @map("tenant_lead_id")
  tenant         Lead?   @relation("TenantActiveLeases", fields: [tenant_lead_id], references: [id])
  // If tenant is not yet a Lead (existing tenant, not through this agency):
  tenant_name    String? @map("tenant_name")
  tenant_email   String? @map("tenant_email")
  tenant_phone   String? @map("tenant_phone")

  // ── Lease terms ───────────────────────────────────────────
  monthly_rent     Decimal  @map("monthly_rent") @db.Decimal(14, 2)
  lease_start_date DateTime @map("lease_start_date")
  lease_end_date   DateTime @map("lease_end_date")
  // "standard_1yr" | "standard_2yr" | "month_to_month" | "stabilized" | "commercial"
  lease_type       String   @default("standard_1yr") @map("lease_type")
  security_deposit Decimal? @map("security_deposit") @db.Decimal(14, 2)
  pets_allowed     Boolean  @default(false) @map("pets_allowed")
  furnished        String   @default("unfurnished") @map("furnished") // "furnished" | "unfurnished" | "partially"

  // ── Renewal tracking ──────────────────────────────────────
  // "unknown" | "renewing" | "not_renewing" | "pending_decision"
  renewal_status      String    @default("unknown") @map("renewal_status")
  renewal_notice_date DateTime? @map("renewal_notice_date")
  renewal_rent        Decimal?  @map("renewal_rent") @db.Decimal(14, 2) // proposed renewal rent
  relist_target_date  DateTime? @map("relist_target_date") // when to relist if not renewing

  // ── Rent history ──────────────────────────────────────────
  original_rent           Decimal?  @map("original_rent") @db.Decimal(14, 2)
  last_rent_increase_date DateTime? @map("last_rent_increase_date")
  last_rent_increase_pct  Decimal?  @map("last_rent_increase_pct") @db.Decimal(5, 2)

  // ── Outreach schedule (90/60/30 days before expiry) ───────
  outreach_90d_sent_at     DateTime? @map("outreach_90d_sent_at")
  outreach_60d_sent_at     DateTime? @map("outreach_60d_sent_at")
  outreach_30d_sent_at     DateTime? @map("outreach_30d_sent_at")
  // Seller conversion (6-month valuation + comps to landlord)
  seller_comps_6mo_sent_at DateTime? @map("seller_comps_6mo_sent_at")
  seller_comps_1yr_sent_at DateTime? @map("seller_comps_1yr_sent_at")

  // ── Board/approval status (condo/coop/condop tenants) ─────
  board_required    Boolean   @default(false) @map("board_required")
  board_app_status  String?   @map("board_app_status")
  board_approved_at DateTime? @map("board_approved_at")

  // ── Move-in record ────────────────────────────────────────
  move_in_date     DateTime? @map("move_in_date")
  keys_given       Boolean   @default(false) @map("keys_given")
  walkthrough_done Boolean   @default(false) @map("walkthrough_done")
  commission_paid  Boolean   @default(false) @map("commission_paid")

  // ── Agent ─────────────────────────────────────────────────
  agent_id BigInt? @map("agent_id")
  agent    Agent?  @relation(fields: [agent_id], references: [id])

  notes         String? @db.Text
  custom_fields Json?   @map("custom_fields")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@index([landlord_lead_id])
  @@index([tenant_lead_id])
  @@index([lease_end_date])
  @@index([renewal_status])
  @@index([status])
  @@index([agent_id])
  @@map("active_leases")
}

// ═══════════════════════════════════════════════════════════
// GEOCODE CACHE — Permanent lat/lng cache for addresses
// US Census Geocoder results cached here so each address
// is geocoded only once. ZIP centroid fallback if API fails.
// ═══════════════════════════════════════════════════════════
model GeocodeCache {
  id          BigInt   @id @default(autoincrement())
  address_key String   @unique @map("address_key") // normalized "123|MAIN ST|10001"
  latitude    Float
  longitude   Float
  source      String   @default("census") // "census" | "zip_centroid"
  created_at  DateTime @default(now()) @map("created_at")

  @@index([address_key])
  @@map("geocode_cache")
}

// ═══════════════════════════════════════════════════════════
// SELLER LEAD — Predictive seller readiness scoring
// Tracks addresses with public-data signals to estimate sell likelihood.
// Uses ONLY non-MLS public data (ACRIS, DOB, first-party behavior).
// ═══════════════════════════════════════════════════════════
model SellerLead {
  id           BigInt  @id @default(autoincrement())
  address      String // Full street address
  unit         String  @default("")
  borough      String?
  neighborhood String?
  postal_code  String? @map("postal_code")
  bbl          String? // 10-digit BBL (borough-block-lot)
  bin          String? // BIN (building ID number)

  // --- Owner info (from ACRIS / public records) ---
  owner_name  String? @map("owner_name")
  owner_email String? @map("owner_email")
  owner_phone String? @map("owner_phone")

  // --- Scoring ---
  readiness_score Int       @default(0) @map("readiness_score") // 0-100
  score_grade     String    @default("F") @map("score_grade") // A/B/C/D/F
  last_scored_at  DateTime? @map("last_scored_at")

  // --- Pipeline status ---
  status            String  @default("new") // new | contacted | replied | meeting | signed | declined
  assigned_agent_id BigInt? @map("assigned_agent_id")
  assigned_agent    Agent?  @relation(fields: [assigned_agent_id], references: [id])

  // --- Consent ---
  consent_given  Boolean   @default(false) @map("consent_given")
  consent_date   DateTime? @map("consent_date")
  consent_method String?   @map("consent_method") // "web_form" | "email_reply" | "verbal"

  // --- Notes ---
  notes String? @db.Text

  // --- Property details (from PLUTO/manual) ---
  property_type String?  @map("property_type")
  beds          Int?
  baths         Decimal? @db.Decimal(3, 1)
  sqft          Int?
  year_built    Int?     @map("year_built")
  building_name String?  @map("building_name")
  floors        Int?
  units_total   Int?     @map("units_total")
  lot_area      Int?     @map("lot_area")

  // --- Ownership enrichment (from ACRIS) ---
  entity_type         String?   @map("entity_type")
  entity_name         String?   @map("entity_name")
  pitch_data          Json?     @map("pitch_data")
  ownership_years     Decimal?  @map("ownership_years") @db.Decimal(4, 1)
  last_purchase_price Decimal?  @map("last_purchase_price") @db.Decimal(14, 2)
  last_purchase_date  DateTime? @map("last_purchase_date")
  mortgage_amount     Decimal?  @map("mortgage_amount") @db.Decimal(14, 2)
  mortgage_date       DateTime? @map("mortgage_date")
  equity_ratio        Decimal?  @map("equity_ratio") @db.Decimal(3, 2)

  // --- Tax (from DOF) ---
  tax_class      String?  @map("tax_class")
  annual_tax     Decimal? @map("annual_tax") @db.Decimal(12, 2)
  market_value   Decimal? @map("market_value") @db.Decimal(14, 2)
  assessed_value Decimal? @map("assessed_value") @db.Decimal(14, 2)

  // --- Building health (from DOB) ---
  open_violations Int?     @default(0) @map("open_violations")
  recent_permits  Int?     @default(0) @map("recent_permits")
  building_risk   Decimal? @map("building_risk") @db.Decimal(3, 2)

  // --- Contact (secondary + professional) ---
  secondary_name         String? @map("secondary_name")
  secondary_phone        String? @map("secondary_phone")
  secondary_email        String? @map("secondary_email")
  secondary_relationship String? @map("secondary_relationship")
  management_company     String? @map("management_company")
  attorney_name          String? @map("attorney_name")
  attorney_email         String? @map("attorney_email")
  attorney_phone         String? @map("attorney_phone")
  authorized_signatories Json?   @map("authorized_signatories")

  // --- Prospecting ---
  source             String?
  source_detail      String?   @map("source_detail")
  pitch_generated_at DateTime? @map("pitch_generated_at")
  pitch_sent_at      DateTime? @map("pitch_sent_at")
  pitch_pdf_url      String?   @map("pitch_pdf_url")

  // --- Conversion ---
  converted_to_lead_id BigInt?   @map("converted_to_lead_id")
  converted_at         DateTime? @map("converted_at")

  // --- Outreach scheduling ---
  next_follow_up     DateTime? @map("next_follow_up")
  last_contacted_at  DateTime? @map("last_contacted_at")
  last_researched_at DateTime? @map("last_researched_at")

  // --- TCPA (align with Lead pattern) ---
  consent_captured_at DateTime? @map("consent_captured_at")
  consent_opt_out_at  DateTime? @map("consent_opt_out_at")

  // --- Relations ---
  signals         ReadinessSignal[]
  outreach_events OutreachEvent[]
  cadence_steps   OutreachCadenceStep[]

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@unique([address, unit])
  @@index([readiness_score])
  @@index([status])
  @@index([assigned_agent_id])
  @@index([bbl])
  @@index([next_follow_up])
  @@index([source])
  @@map("seller_leads")
}

// ═══════════════════════════════════════════════════════════
// READINESS SIGNAL — Individual scoring signals per address
// ═══════════════════════════════════════════════════════════
model ReadinessSignal {
  id             BigInt     @id @default(autoincrement())
  seller_lead_id BigInt     @map("seller_lead_id")
  seller_lead    SellerLead @relation(fields: [seller_lead_id], references: [id], onDelete: Cascade)

  signal_type String  @map("signal_type") // ownership_duration | mortgage_age | equity_estimate | dob_permits | renovation_signal | building_risk | page_visit | cma_request | valuation_form
  raw_value   String? @map("raw_value") // Original value (e.g., "12 years", "$450000")
  normalized  Float   @default(0) // 0.0 – 1.0 normalized score
  source      String  @default("system") // "acris" | "dob" | "first_party" | "manual"
  metadata    Json? // Extra context (document IDs, dates, etc.)

  collected_at DateTime @default(now()) @map("collected_at")

  @@index([seller_lead_id])
  @@index([signal_type])
  @@map("readiness_signals")
}

// ═══════════════════════════════════════════════════════════
// OUTREACH EVENT — Audit trail for seller outreach
// ═══════════════════════════════════════════════════════════
model OutreachEvent {
  id             BigInt     @id @default(autoincrement())
  seller_lead_id BigInt     @map("seller_lead_id")
  seller_lead    SellerLead @relation(fields: [seller_lead_id], references: [id], onDelete: Cascade)

  channel      String // "email" | "letter" | "phone" | "door_knock"
  direction    String  @default("outbound") // "outbound" | "inbound"
  template_id  String? @map("template_id") // Reference to outreach template used
  subject      String?
  body_preview String? @map("body_preview") @db.Text // First 500 chars for audit
  outcome      String? // "sent" | "delivered" | "opened" | "replied" | "bounced" | "declined"

  // --- TCPA compliance ---
  consent_verified Boolean @default(false) @map("consent_verified")

  agent_id BigInt @map("agent_id")

  created_at DateTime @default(now()) @map("created_at")

  @@index([seller_lead_id])
  @@index([agent_id])
  @@index([created_at])
  @@map("outreach_events")
}

// ═══════════════════════════════════════════════════════════════════════════════
// OUTREACH CADENCE STEP — Scheduled outreach for seller prospects
// ═══════════════════════════════════════════════════════════════════════════════
model OutreachCadenceStep {
  id             BigInt     @id @default(autoincrement())
  seller_lead_id BigInt     @map("seller_lead_id")
  seller_lead    SellerLead @relation(fields: [seller_lead_id], references: [id], onDelete: Cascade)

  day_offset      Int     @map("day_offset")
  type            String
  channel         String  @default("email")
  subject         String?
  content_preview String? @map("content_preview") @db.Text

  status         String    @default("pending")
  scheduled_date DateTime? @map("scheduled_date")
  sent_at        DateTime? @map("sent_at")
  opened_at      DateTime? @map("opened_at")
  replied_at     DateTime? @map("replied_at")

  content_type String? @map("content_type")
  content_data Json?   @map("content_data")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@index([seller_lead_id])
  @@index([scheduled_date])
  @@index([status])
  @@map("outreach_cadence_steps")
}

// ═══════════════════════════════════════════════════════════
// PRICING EXPERIMENT — A/B marketing strategy experiments
// Compares two arms (control + treatment) on internal listings.
// Uses buyer engagement signals only — NO MLS data manipulation.
// ═══════════════════════════════════════════════════════════
model PricingExperiment {
  id                     BigInt    @id @default(autoincrement())
  name                   String
  description            String?   @db.Text
  experiment_type        String    @map("experiment_type") // exposure_level | showing_strategy | photo_order | description_variant
  status                 String    @default("draft") // draft | active | concluded | archived
  created_by_id          BigInt    @map("created_by_id")
  created_by             Agent     @relation(fields: [created_by_id], references: [id])
  start_date             DateTime? @map("start_date")
  end_date               DateTime? @map("end_date")
  target_sample_size     Int?      @map("target_sample_size")
  significance_threshold Decimal   @default(0.95) @map("significance_threshold") @db.Decimal(4, 3)
  conclusion_notes       String?   @map("conclusion_notes") @db.Text
  result_summary         Json?     @map("result_summary") // Final ExperimentResult JSON

  arms ExperimentArm[]

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([created_by_id])
  @@index([experiment_type])
  @@map("pricing_experiments")
}

// ═══════════════════════════════════════════════════════════
// EXPERIMENT ARM — Control or treatment variant
// ═══════════════════════════════════════════════════════════
model ExperimentArm {
  id              BigInt            @id @default(autoincrement())
  experiment_id   BigInt            @map("experiment_id")
  experiment      PricingExperiment @relation(fields: [experiment_id], references: [id], onDelete: Cascade)
  name            String // "Control", "Extended Exposure", etc.
  is_control      Boolean           @default(false) @map("is_control")
  config          Json              @default("{}") // Strategy-specific config
  summary_metrics Json              @default("{}") @map("summary_metrics") // Aggregated KPIs (computed by cron)

  @@index([experiment_id])
  @@map("experiment_arms")
}

// ═══════════════════════════════════════════════════════════
// G. DEMAND HEATMAP — Hyperlocal demand signals
// ═══════════════════════════════════════════════════════════

model DemandSignal {
  id           BigInt   @id @default(autoincrement())
  signal_type  String   @map("signal_type")
  neighborhood String
  borough      String?
  postal_code  String?  @map("postal_code")
  value        Float    @default(0)
  normalized   Float    @default(0)
  source       String   @default("soda")
  metadata     Json?
  period_start DateTime @map("period_start")
  period_end   DateTime @map("period_end")
  collected_at DateTime @default(now()) @map("collected_at")

  @@index([neighborhood, signal_type])
  @@index([signal_type])
  @@map("demand_signals")
}

model DemandIndex {
