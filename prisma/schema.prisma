generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model active_leases {
  id                                          BigInt    @id @default(autoincrement())
  address                                     String
  unit                                        String?
  borough                                     String?
  neighborhood                                String?
  zip                                         String?
  building_type                               String?
  landlord_lead_id                            BigInt
  tenant_lead_id                              BigInt?
  tenant_name                                 String?
  tenant_email                                String?
  tenant_phone                                String?
  monthly_rent                                Decimal   @db.Decimal(14, 2)
  lease_start_date                            DateTime
  lease_end_date                              DateTime
  lease_type                                  String    @default("standard_1yr")
  security_deposit                            Decimal?  @db.Decimal(14, 2)
  pets_allowed                                Boolean   @default(false)
  furnished                                   String    @default("unfurnished")
  renewal_status                              String    @default("unknown")
  renewal_notice_date                         DateTime?
  renewal_rent                                Decimal?  @db.Decimal(14, 2)
  relist_target_date                          DateTime?
  original_rent                               Decimal?  @db.Decimal(14, 2)
  last_rent_increase_date                     DateTime?
  last_rent_increase_pct                      Decimal?  @db.Decimal(5, 2)
  outreach_90d_sent_at                        DateTime?
  outreach_60d_sent_at                        DateTime?
  outreach_30d_sent_at                        DateTime?
  seller_comps_6mo_sent_at                    DateTime?
  seller_comps_1yr_sent_at                    DateTime?
  board_required                              Boolean   @default(false)
  board_app_status                            String?
  board_approved_at                           DateTime?
  move_in_date                                DateTime?
  keys_given                                  Boolean   @default(false)
  walkthrough_done                            Boolean   @default(false)
  commission_paid                             Boolean   @default(false)
  agent_id                                    BigInt?
  notes                                       String?
  custom_fields                               Json?
  created_at                                  DateTime  @default(now())
  updated_at                                  DateTime
  status                                      String    @default("active")
  agents                                      agents?   @relation(fields: [agent_id], references: [id])
  leads_active_leases_landlord_lead_idToleads leads     @relation("active_leases_landlord_lead_idToleads", fields: [landlord_lead_id], references: [id])
  leads_active_leases_tenant_lead_idToleads   leads?    @relation("active_leases_tenant_lead_idToleads", fields: [tenant_lead_id], references: [id])

  @@index([agent_id])
  @@index([landlord_lead_id])
  @@index([lease_end_date])
  @@index([renewal_status])
  @@index([status])
  @@index([tenant_lead_id])
}

model activity_logs {
  id            BigInt   @id @default(autoincrement())
  lead_id       BigInt
  activity_type String
  title         String
  detail        String?
  metadata      Json     @default("{}")
  actor_type    String   @default("system")
  actor_id      BigInt?
  created_at    DateTime @default(now())
  leads         leads    @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id, created_at])
}

model agent_metrics {
  id         BigInt   @id @default(autoincrement())
  agent_id   BigInt
  month      DateTime
  metrics    Json     @default("{}")
  created_at DateTime @default(now())
  updated_at DateTime
  agents     agents   @relation(fields: [agent_id], references: [id])

  @@unique([agent_id, month])
  @@index([agent_id])
  @@index([month])
}

model agent_performance_indices {
  id              BigInt   @id @default(autoincrement())
  agent_id        BigInt   @unique
  index_score     Int      @default(0)
  rank            Int?
  tier            String   @default("bronze")
  components      Json     @default("{}")
  months_included Int      @default(0)
  last_computed   DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime
  agents          agents   @relation(fields: [agent_id], references: [id])

  @@index([index_score])
  @@index([tier])
}

model agents {
  id                        BigInt                     @id @default(autoincrement())
  first_name                String
  last_name                 String
  full_name                 String?
  email                     String                     @unique
  password_hash             String
  phone                     String?
  license_no                String?
  license_type              String?
  license_expiry            DateTime?
  sale_split                Decimal?                   @db.Decimal(6, 3)
  rental_split              Decimal?                   @db.Decimal(6, 3)
  role                      String                     @default("AGENT")
  status                    String                     @default("active")
  last_login                DateTime?
  created_at                DateTime                   @default(now())
  updated_at                DateTime
  bio                       String?
  featured                  Boolean                    @default(false)
  languages                 String[]                   @default([])
  photo                     String?
  public_slug               String?                    @unique
  specialties               String[]                   @default([])
  title                     String?
  outlook_access_token      String?
  outlook_refresh_token     String?
  outlook_token_expires_at  DateTime?
  trestle_mls_id            String?
  mfa_backup_hashes         String[]                   @default([])
  mfa_enabled               Boolean                    @default(false)
  mfa_secret_enc            String?
  active_leases             active_leases[]
  agent_metrics             agent_metrics[]
  agent_performance_indices agent_performance_indices?
  campaigns                 campaigns[]
  cma_reports               cma_reports[]
  deals                     deals[]
  demand_alerts             demand_alerts[]
  documents                 documents[]
  follow_up_tasks           follow_up_tasks[]
  lead_assignment_rules     lead_assignment_rules[]
  leads                     leads[]
  listings                  listings[]
  marketing_activities      marketing_activities[]
  past_deals                past_deals[]
  pricing_experiments       pricing_experiments[]
  protected_periods         protected_periods[]
  saved_searches            saved_searches[]
  seller_leads              seller_leads[]
  showings                  showings[]
}

model audit_events {
  id          BigInt   @id @default(autoincrement())
  action      String
  entity_type String
  entity_id   String
  user_type   String
  user_id     BigInt?
  changes     Json?
  ip_address  String?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([entity_type, entity_id])
  @@index([user_type, user_id])
}

model behavioral_events {
  id          BigInt   @id @default(autoincrement())
  session_id  String
  lead_id     BigInt?
  listing_id  String?
  event_type  String
  value       Float?
  metadata    Json     @default("{}")
  page_path   String?
  recorded_at DateTime @default(now())

  @@index([event_type])
  @@index([lead_id, event_type])
  @@index([lead_id])
  @@index([listing_id])
  @@index([recorded_at])
  @@index([session_id])
}

model buyer_intent_profiles {
  id                      BigInt    @id @default(autoincrement())
  lead_id                 BigInt    @unique
  intent_strength         Int       @default(0)
  intent_stage            String    @default("browsing")
  price_min               Decimal?  @db.Decimal(14, 2)
  price_max               Decimal?  @db.Decimal(14, 2)
  preferred_neighborhoods String[]
  preferred_types         String[]
  preferred_beds          Int[]
  amenity_preferences     String[]
  preferred_boroughs      String[]
  top_features            Json      @default("{}")
  event_count             Int       @default(0)
  last_event_at           DateTime?
  last_computed           DateTime  @default(now())
  created_at              DateTime  @default(now())
  updated_at              DateTime
  leads                   leads     @relation(fields: [lead_id], references: [id])

  @@index([intent_stage])
  @@index([intent_strength])
}

model campaign_recipients {
  id           BigInt    @id @default(autoincrement())
  campaign_id  BigInt
  lead_id      BigInt
  sent_at      DateTime?
  opened_at    DateTime?
  clicked_at   DateTime?
  responded_at DateTime?
  campaigns    campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  leads        leads     @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, lead_id])
  @@index([lead_id])
}

model campaigns {
  id                  BigInt                @id @default(autoincrement())
  agent_id            BigInt
  crm_type            String
  name                String
  audience_type       String
  campaign_type       String
  status              String                @default("draft")
  frequency           String?
  recipient_count     Int                   @default(0)
  sent_count          Int                   @default(0)
  open_count          Int                   @default(0)
  click_count         Int                   @default(0)
  response_count      Int                   @default(0)
  last_run_at         DateTime?
  next_run_at         DateTime?
  template_id         String?
  filters             Json?
  created_at          DateTime              @default(now())
  updated_at          DateTime
  campaign_recipients campaign_recipients[]
  agents              agents                @relation(fields: [agent_id], references: [id])

  @@index([agent_id])
  @@index([crm_type, status])
}

model client_listing_actions {
  id         BigInt   @id @default(autoincrement())
  lead_id    BigInt
  listing_id BigInt
  action     String
  comment    String?
  created_at DateTime @default(now())
  leads      leads    @relation(fields: [lead_id], references: [id])
  listings   listings @relation(fields: [listing_id], references: [id])

  @@unique([lead_id, listing_id, action])
  @@index([lead_id])
  @@index([listing_id])
}

model client_preferences {
  id             BigInt    @id @default(autoincrement())
  lead_id        BigInt    @unique
  property_types String[]
  neighborhoods  String[]
  boroughs       String[]
  min_beds       Int?
  max_beds       Int?
  min_baths      Int?
  max_baths      Int?
  min_price      Decimal?  @db.Decimal(14, 2)
  max_price      Decimal?  @db.Decimal(14, 2)
  min_sqft       Int?
  must_haves     String[]
  deal_breakers  String[]
  move_in_date   DateTime?
  notes          String?
  created_at     DateTime  @default(now())
  updated_at     DateTime
  leads          leads     @relation(fields: [lead_id], references: [id])

  @@index([lead_id])
}

model cma_reports {
  id               BigInt   @id @default(autoincrement())
  agent_id         BigInt
  property_address String
  borough          String?
  neighborhood     String?
  subject_details  Json     @default("{}")
  comps            Json     @default("[]")
  adjustments      Json     @default("[]")
  estimated_value  Decimal? @db.Decimal(14, 2)
  price_range_low  Decimal? @db.Decimal(14, 2)
  price_range_high Decimal? @db.Decimal(14, 2)
  status           String   @default("draft")
  notes            String?
  created_at       DateTime @default(now())
  updated_at       DateTime
  agents           agents   @relation(fields: [agent_id], references: [id])

  @@index([agent_id])
  @@index([neighborhood])
}

model comments {
  id             BigInt     @id @default(autoincrement())
  listing_id     BigInt
  lead_id        BigInt
  parent_id      BigInt?
  body           String
  created_at     DateTime   @default(now())
  updated_at     DateTime
  leads          leads      @relation(fields: [lead_id], references: [id])
  listings       listings   @relation(fields: [listing_id], references: [id])
  comments       comments?  @relation("commentsTocomments", fields: [parent_id], references: [id])
  other_comments comments[] @relation("commentsTocomments")

  @@index([lead_id])
  @@index([listing_id])
  @@index([parent_id])
}

model commission_payments {
  id           BigInt    @id @default(autoincrement())
  deal_id      BigInt
  payment_type String
  amount       Decimal   @db.Decimal(14, 2)
  date         DateTime?
  status       String    @default("pending")
  reference    String?
  notes        String?
  created_at   DateTime  @default(now())
  updated_at   DateTime
  deals        deals     @relation(fields: [deal_id], references: [id])

  @@index([deal_id])
  @@index([payment_type])
  @@index([status])
}

model conviction_scores {
  id                     BigInt    @id @default(autoincrement())
  lead_id                BigInt    @unique
  score                  Int       @default(0)
  stage                  String    @default("browsing")
  milestone_flags        Json      @default("{}")
  hesitation_signals     Json      @default("{}")
  ghost_status           String    @default("active")
  last_active_at         DateTime?
  silence_days           Int       @default(0)
  search_narrowing_trend Float?
  top_listings           Json      @default("[]")
  last_computed          DateTime  @default(now())
  created_at             DateTime  @default(now())
  updated_at             DateTime

  @@index([ghost_status])
  @@index([score])
}

model deals {
  id                      BigInt                @id @default(autoincrement())
  agent_id                BigInt
  representation_code     String?
  property_address        String?
  price_usd               Decimal?              @db.Decimal(14, 2)
  commission_rate_percent Decimal?              @db.Decimal(6, 3)
  split_percent           Decimal?              @db.Decimal(6, 3)
  agent_fee_usd           Decimal?              @db.Decimal(14, 2)
  company_fee_usd         Decimal?              @db.Decimal(14, 2)
  gross_commission_usd    Decimal?              @db.Decimal(14, 2)
  status                  String                @default("draft")
  contract_signed         DateTime?
  contract_closed         DateTime?
  created_at              DateTime              @default(now())
  updated_at              DateTime
  commission_payments     commission_payments[]
  agents                  agents                @relation(fields: [agent_id], references: [id])
  documents               documents[]

  @@index([agent_id])
  @@index([status])
}

model demand_alerts {
  id              BigInt         @id @default(autoincrement())
  agent_id        BigInt
  demand_index_id BigInt
  neighborhood    String
  alert_type      String
  threshold       Int            @default(70)
  enabled         Boolean        @default(true)
  last_triggered  DateTime?
  last_value      Int?
  created_at      DateTime       @default(now())
  updated_at      DateTime
  agents          agents         @relation(fields: [agent_id], references: [id])
  demand_indices  demand_indices @relation(fields: [demand_index_id], references: [id], onDelete: Cascade)

  @@unique([agent_id, demand_index_id, alert_type])
  @@index([agent_id])
  @@index([enabled])
}

model demand_indices {
  id            BigInt          @id @default(autoincrement())
  neighborhood  String          @unique
  borough       String?
  score         Int             @default(0)
  trend         String          @default("stable")
  trend_delta   Float           @default(0)
  components    Json            @default("{}")
  signal_count  Int             @default(0)
  last_computed DateTime        @default(now())
  created_at    DateTime        @default(now())
  updated_at    DateTime
  demand_alerts demand_alerts[]

  @@index([borough])
  @@index([score])
}

model demand_signals {
  id           BigInt   @id @default(autoincrement())
  signal_type  String
  neighborhood String
  borough      String?
  postal_code  String?
  value        Float    @default(0)
  normalized   Float    @default(0)
  source       String   @default("soda")
  metadata     Json?
  period_start DateTime
  period_end   DateTime
  collected_at DateTime @default(now())

  @@index([collected_at])
  @@index([neighborhood, signal_type])
  @@index([signal_type])
}

model document_signatures {
  id           BigInt    @id @default(autoincrement())
  document_id  BigInt
  signer_name  String
  signer_email String
  signer_role  String
  signed_at    DateTime?
  ip_address   String?
  status       String    @default("pending")
  created_at   DateTime  @default(now())
  documents    documents @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id])
}

model documents {
  id                  BigInt                @id @default(autoincrement())
  deal_id             BigInt?
  agent_id            BigInt
  name                String
  doc_type            String
  file_url            String
  file_size           Int?
  mime_type           String?
  status              String                @default("uploaded")
  requires_signature  Boolean               @default(false)
  notes               String?
  created_at          DateTime              @default(now())
  updated_at          DateTime
  document_signatures document_signatures[]
  agents              agents                @relation(fields: [agent_id], references: [id])
  deals               deals?                @relation(fields: [deal_id], references: [id])

  @@index([agent_id])
  @@index([deal_id])
  @@index([doc_type])
  @@index([status])
}

model engagement_events {
  id                    BigInt              @id @default(autoincrement())
  experiment_listing_id BigInt
  event_type            String
  value                 Decimal?            @db.Decimal(14, 2)
  metadata              Json?
  recorded_at           DateTime            @default(now())
  experiment_listings   experiment_listings @relation(fields: [experiment_listing_id], references: [id], onDelete: Cascade)

  @@index([event_type])
  @@index([experiment_listing_id])
  @@index([recorded_at])
}

model experiment_arms {
  id                  BigInt                @id @default(autoincrement())
  experiment_id       BigInt
  name                String
  is_control          Boolean               @default(false)
  config              Json                  @default("{}")
  summary_metrics     Json                  @default("{}")
  pricing_experiments pricing_experiments   @relation(fields: [experiment_id], references: [id], onDelete: Cascade)
  experiment_listings experiment_listings[]

  @@index([experiment_id])
}

model experiment_listings {
  id                    BigInt              @id @default(autoincrement())
  arm_id                BigInt
  listing_id            String
  listing_address       String?
  seller_consent        Boolean             @default(false)
  consent_timestamp     DateTime?
  consent_method        String?
  consent_terms_version String?
  enrolled_at           DateTime            @default(now())
  withdrawn_at          DateTime?
  engagement_events     engagement_events[]
  experiment_arms       experiment_arms     @relation(fields: [arm_id], references: [id], onDelete: Cascade)

  @@unique([arm_id, listing_id])
  @@index([listing_id])
}

model family_members {
  id                                         BigInt   @id @default(autoincrement())
  lead_id                                    BigInt
  member_lead_id                             BigInt
  relationship                               String?
  created_at                                 DateTime @default(now())
  leads_family_members_lead_idToleads        leads    @relation("family_members_lead_idToleads", fields: [lead_id], references: [id])
  leads_family_members_member_lead_idToleads leads    @relation("family_members_member_lead_idToleads", fields: [member_lead_id], references: [id])

  @@unique([lead_id, member_lead_id])
  @@index([lead_id])
  @@index([member_lead_id])
}

model featured_configs {
  id            BigInt   @id @default(autoincrement())
  pinned_ids    String[] @default([])
  filters       Json     @default("{}")
  sort          String   @default("price-desc")
  display_limit Int      @default(6)
  is_active     Boolean  @default(true)
  updated_by    BigInt?
  created_at    DateTime @default(now())
  updated_at    DateTime
}

model financial_ledger {
  id              BigInt   @id @default(autoincrement())
  deal_id         BigInt?
  payment_id      BigInt?
  entry_type      String
  amount          Decimal  @db.Decimal(14, 2)
  running_balance Decimal? @db.Decimal(14, 2)
  description     String
  reference       String?
  recorded_by     BigInt
  immutable_hash  String?
  created_at      DateTime @default(now())

  @@index([created_at])
  @@index([deal_id])
  @@index([entry_type])
  @@index([payment_id])
}

model follow_up_tasks {
  id           BigInt    @id @default(autoincrement())
  lead_id      BigInt
  agent_id     BigInt
  title        String
  description  String?
  due_date     DateTime
  priority     String    @default("medium")
  status       String    @default("pending")
  task_type    String    @default("follow_up")
  completed_at DateTime?
  created_at   DateTime  @default(now())
  agents       agents    @relation(fields: [agent_id], references: [id])
  leads        leads     @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([agent_id, status])
  @@index([due_date])
  @@index([lead_id])
}

model geocode_cache {
  id          BigInt   @id @default(autoincrement())
  address_key String   @unique
  latitude    Float
  longitude   Float
  source      String   @default("census")
  created_at  DateTime @default(now())

  @@index([address_key])
}

model intent_events {
  id          BigInt   @id @default(autoincrement())
  lead_id     BigInt
  event_type  String
  payload     Json     @default("{}")
  session_id  String?
  recorded_at DateTime @default(now())
  leads       leads    @relation(fields: [lead_id], references: [id])

  @@index([event_type])
  @@index([lead_id, event_type])
  @@index([lead_id])
  @@index([recorded_at])
}

model lead_assignment_rules {
  id                  BigInt   @id @default(autoincrement())
  agent_id            BigInt
  criteria            Json     @default("{}")
  priority            Int      @default(50)
  max_leads_per_month Int      @default(50)
  current_month_count Int      @default(0)
  active              Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime
  agents              agents   @relation(fields: [agent_id], references: [id])

  @@index([active])
  @@index([agent_id])
}

model lead_parties {
  id                 BigInt   @id @default(autoincrement())
  lead_id            BigInt
  first_name         String
  last_name          String
  email              String?
  phone              String?
  address            String?
  role               String
  signs_documents    Boolean  @default(false)
  signing_capacity   String?
  appears_on_deed    Boolean  @default(false)
  appears_on_lease   Boolean  @default(false)
  appears_on_board   Boolean  @default(false)
  is_entity          Boolean  @default(false)
  entity_type        String?
  entity_name        String?
  entity_ein         String?
  entity_state       String?
  annual_income      Decimal? @db.Decimal(14, 2)
  credit_score_range String?
  employer           String?
  work_title         String?
  has_portal_access  Boolean  @default(false)
  portal_email       String?
  notes              String?
  created_at         DateTime @default(now())
  updated_at         DateTime
  leads              leads    @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id])
}

model lead_scores {
  id               BigInt   @id @default(autoincrement())
  lead_id          BigInt   @unique
  score            Int      @default(0)
  grade            String   @default("C")
  source_score     Int      @default(0)
  engagement_score Int      @default(0)
  recency_score    Int      @default(0)
  fit_score        Int      @default(0)
  last_computed    DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime
  leads            leads    @relation(fields: [lead_id], references: [id])

  @@index([grade])
  @@index([score])
}

model leads {
  id                                                  BigInt                   @id @default(autoincrement())
  first_name                                          String
  last_name                                           String
  email                                               String                   @unique
  phone                                               String
  roles                                               String[]
  status                                              String                   @default("new")
  portal_role                                         String?
  portal_token                                        String?                  @unique
  password_hash                                       String?
  agent_id                                            BigInt?
  source                                              String                   @default("website")
  created_at                                          DateTime                 @default(now())
  updated_at                                          DateTime
  anonymous_session_id                                String?
  consent_captured_at                                 DateTime?
  portal_token_expires_at                             DateTime?
  buyer_rep_agreement                                 Boolean                  @default(false)
  buyer_rep_agreement_date                            DateTime?
  attorney_email                                      String?
  attorney_firm                                       String?
  attorney_name                                       String?
  attorney_phone                                      String?
  annual_income                                       Decimal?                 @db.Decimal(14, 2)
  credit_score_range                                  String?
  last_contacted_at                                   DateTime?
  lease_end_date                                      DateTime?
  next_follow_up                                      DateTime?
  pipeline_stage                                      String                   @default("new")
  pre_approved                                        Boolean                  @default(false)
  pre_approved_amount                                 Decimal?                 @db.Decimal(14, 2)
  notes                                               String?
  lease_start_date                                    DateTime?
  bonuses                                             Decimal?                 @db.Decimal(14, 2)
  down_payment                                        Decimal?                 @db.Decimal(14, 2)
  available_funds                                     Decimal?                 @db.Decimal(14, 2)
  monthly_debt                                        Decimal?                 @db.Decimal(14, 2)
  employer                                            String?
  work_title                                          String?
  rent_per_month                                      Decimal?                 @db.Decimal(14, 2)
  rental_deposit                                      Decimal?                 @db.Decimal(14, 2)
