generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------
// AGENT (natural key = email)
// --------------------------------------------------
model Agent {
  email            String   @id                      // natural key
  firstName        String
  lastName         String
  secondEmail      String?
  licenseNo        String   @unique
  licenseExpiry    DateTime
  saleSplit        Int      // basis points (8000 = 80 %)
  rentalSplit      Int      // basis points (7000 = 70 %)
  saleDeals        Int      @default(0)
  rentalDeals      Int      @default(0)
  role             Role     @default(AGENT)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  listings    Listing[]
  leads       Lead[]
  deals       Deal[]
  commissions Commission[]
  splits      Split[]
  profile     AgentProfile?

  @@map("agents")
}

// --------------------------------------------------
// AGENT PROFILE (same natural key)
// --------------------------------------------------
model AgentProfile {
  email            String   @id                      // same as Agent
  agent            Agent    @relation(fields: [email], references: [email], onDelete: Cascade)
  secondEmail      String?
  saleSplit        Int
  rentalSplit      Int
  saleDeals        Int      @default(0)
  rentalDeals      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@map("agent_profiles")
}

// --------------------------------------------------
// DEAL (natural key = address + agentEmail + contractSigned)
// --------------------------------------------------
model Deal {
  address          String
  agentEmail       String
  agent            Agent    @relation(fields: [agentEmail], references: [email], onDelete: Cascade)
  type             String   // SALE or RENTAL
  status           DealStatus @default(LEAD)
  price            Int
  closingDate      DateTime?
  contractSigned   DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  commissions      Commission[]
  dealDetails      DealDetail?

  @@id([address, agentEmail, contractSigned])   // natural composite key
  @@map("deals")
}

// --------------------------------------------------
// DEAL DETAIL (same natural key)
// --------------------------------------------------
model DealDetail {
  address            String
  agentEmail         String
  contractSigned     DateTime
  deal               Deal     @relation(fields: [address, agentEmail, contractSigned], references: [address, agentEmail, contractSigned], onDelete: Cascade)
  agentFirstName     String
  agentLastName      String
  agentLicense       String
  type               String   // SALE or RENTAL
  price              Int
  agentCommissionPct Int      // basis points (300 = 3 %)
  agentCommissionUsd Int      // dollar amount
  split              Int      // basis points (8000 = 80 %)
  contractClosed     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@id([address, agentEmail, contractSigned])   // same composite key
  @@map("deal_details")
}

// --------------------------------------------------
// COMMISSION (natural key = same composite key)
// --------------------------------------------------
model Commission {
  address          String
  agentEmail       String
  contractSigned   DateTime
  deal             Deal     @relation(fields: [address, agentEmail, contractSigned], references: [address, agentEmail, contractSigned], onDelete: Cascade)
  gross            Int
  companyFee       Int
  agentFee         Int
  paid             Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@id([address, agentEmail, contractSigned])   // same composite key
  @@map("commissions")
}

// --------------------------------------------------
// SPLIT (natural key = agentEmail + year)
// --------------------------------------------------
model Split {
  agentEmail       String
  year             Int      // 2025, 2026, …
  agent            Agent    @relation(fields: [agentEmail], references: [email], onDelete: Cascade)
  saleSplit        Int
  rentalSplit      Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@id([agentEmail, year])
  @@map("splits")
}

// --------------------------------------------------
// SUPPORTING TABLES (no id)
// --------------------------------------------------
model SplitPlan {
  name         String @id   // natural key: "80-20", "70-30"
  companySplit Int
  agentSplit   Int
  agents       Agent[]
  @@map("split_plans")
}

model Lead {
  email        String   @id   // natural key
  name         String
  phone        String?
  consentSms   Boolean  @default(false)
  consentEmail Boolean  @default(false)
  note         String?
  assignedToId String?   // can be null
  assignedTo   Agent?    @relation(fields: [assignedToId], references: [email])
  createdAt    DateTime @default(now())
  @@map("leads")
}

model Listing {
  address   String        @id   // natural key
  price     Int
  beds      Float?
  baths     Float?
  sqft      Int?
  status    ListingStatus @default(DRAFT)
  agentId   String        // agent email
  agent     Agent         @relation(fields: [agentId], references: [email])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@map("listings")
}

model Document {
  filename    String    @id   // natural key (unique per folder)
  category    DocCategory
  url         String
  uploadedBy  String
  createdAt   DateTime @default(now())
  @@map("documents")
}

// --------------------------------------------------
// ENUMS (unchanged)
// --------------------------------------------------
enum Role            { ADMIN AGENT }
enum ListingStatus   { DRAFT ACTIVE PENDING CLOSED }
enum DealSide        { BUY SELL RENT }
enum DealStatus      { LEAD SHOWING OFFER CONTRACT_NEGOTIATION CLOSED }
enum DocCategory     { OFFERING_PLAN AGENCY_DISCLOSURE LEAD_PAINT WINDOW_GUARD 1099 MISC }
