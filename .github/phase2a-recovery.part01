pending_lane = """  emitCursorTelemetry("batch", runId, {
    batch_count: properties.length,
    first_photos_change: firstProp?.PhotosChangeTimestamp ?? null,
    first_listing_key: firstProp?.ListingKey ?? null,
    last_photos_change: lastProp?.PhotosChangeTimestamp ?? null,
    last_listing_key: lastProp?.ListingKey ?? null,
  });

  reconcileStateAvailable = await mediaSyncStateTableAvailable();
  const pendingHandled = new Set<string>();
  if (reconcileStateAvailable) {
    try {
      const stats = await getPendingQueueStats();
      pendingQueueCount = stats.count;
      pendingQueueOldestAgeSeconds = stats.oldestFirstObservedAt
        ? Math.max(0, Math.floor((now() - stats.oldestFirstObservedAt.getTime()) / 1000))
        : null;
      const pendingRows = await selectPendingLane(PENDING_VERIFICATION_LIMIT, new Date(now()));
      for (const pendingRow of pendingRows) {
        if (remainingMs() < phase1ReserveMs) break;
        try {
          const refs = await prisma.listingMedia.findMany({
            where: { listing_id: pendingRow.listingId, status: "active" },
            select: { media_key: true, resource_record_key: true },
          });
          const listingKey = refs.find(
            (row) =>
              typeof row.media_key === "string" &&
              !row.media_key.startsWith(CRM_MEDIA_KEY_PREFIX) &&
              typeof row.resource_record_key === "string" &&
              row.resource_record_key.length > 0,
          )?.resource_record_key;
          if (!listingKey) continue;
          const mediaRows = await fetchDeps.fetchMedia(listingKey);
          const result = await processMediaSet({
            listingId: pendingRow.listingId,
            listingKey,
            photosChangeTs: pendingRow.pending?.photosChangeTimestamp ?? pendingRow.lastSeenPhotosChangeTs,
            sourceModificationTs:
              pendingRow.pending?.sourceModificationTs ?? pendingRow.lastSourceModificationTs,
            mediaRows,
          });
          if (result.ok) pendingHandled.add(pendingRow.listingId);
        } catch {
          rowsFailed++;
        }
      }
    } catch {
      // Capability was present at run start but the state lane became unreadable.
      // Fail closed for optimization: keep legacy media behavior for this run.
      reconcileStateAvailable = false;
    }
  }

  for (const property of properties) {
"""
replace_once("lib/idx/media-sync.ts", batch_anchor, pending_lane)

replace_once(
