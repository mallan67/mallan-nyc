# Add per-listing reconciliation state to Prisma schema.
replace_once(
    "prisma/schema.prisma",
    "  listing_media             ListingMedia[]\n  listing_search_projection ListingSearchProjection?\n",
    "  listing_media             ListingMedia[]\n  listing_media_sync_state  ListingMediaSyncState?\n  listing_search_projection ListingSearchProjection?\n",
)
sub_once(
    "prisma/schema.prisma",
    r"(model MediaSyncState \{.*?\n\})",
    lambda match: match.group(1) + "\n\n" + '// Per-listing authoritative media reconciliation checkpoint and bounded pending lane.\nmodel ListingMediaSyncState {\n  id                                  BigInt    @id @default(autoincrement())\n  listing_id                          String    @unique @map("listing_id")\n  listing                             Listing   @relation(fields: [listing_id], references: [listing_id], onDelete: Cascade)\n  last_seen_photos_change_ts          DateTime? @map("last_seen_photos_change_ts")\n  last_complete_media_set_hash        String?   @map("last_complete_media_set_hash")\n  last_reconciled_at                  DateTime? @map("last_reconciled_at")\n  last_source_modification_ts         DateTime? @map("last_source_modification_ts")\n  pending_candidate_set_hash          String?   @map("pending_candidate_set_hash")\n  pending_candidate_media_count       Int?      @map("pending_candidate_media_count")\n  pending_missing_media_count         Int?      @map("pending_missing_media_count")\n  pending_photos_change_timestamp     DateTime? @map("pending_photos_change_timestamp")\n  pending_source_modification_ts      DateTime? @map("pending_source_modification_ts")\n  pending_first_observed_at           DateTime? @map("pending_first_observed_at")\n  pending_last_observation_run_id     String?   @map("pending_last_observation_run_id")\n  pending_confirmation_count          Int       @default(0) @map("pending_confirmation_count")\n  pending_next_check_at               DateTime? @map("pending_next_check_at")\n  created_at                          DateTime  @default(now()) @map("created_at")\n  updated_at                          DateTime  @updatedAt @map("updated_at")\n\n  @@index([pending_next_check_at])\n  @@map("listing_media_sync_state")\n}\n',
    flags=re.S,
)

write(
    "prisma/migrations/20260726120000_add_listing_media_sync_state/migration.sql",
    """-- Phase 2A: new-empty per-listing media reconciliation state table.
CREATE TABLE "listing_media_sync_state" (
"id" BIGSERIAL NOT NULL,
"listing_id" TEXT NOT NULL,
"last_seen_photos_change_ts" TIMESTAMP(3),
"last_complete_media_set_hash" TEXT,
"last_reconciled_at" TIMESTAMP(3),
"last_source_modification_ts" TIMESTAMP(3),
"pending_candidate_set_hash" TEXT,
"pending_candidate_media_count" INTEGER,
"pending_missing_media_count" INTEGER,
"pending_photos_change_timestamp" TIMESTAMP(3),
"pending_source_modification_ts" TIMESTAMP(3),
"pending_first_observed_at" TIMESTAMP(3),
"pending_last_observation_run_id" TEXT,
"pending_confirmation_count" INTEGER NOT NULL DEFAULT 0,
"pending_next_check_at" TIMESTAMP(3),
"created_at" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
"updated_at" TIMESTAMP(3) NOT NULL,
CONSTRAINT "listing_media_sync_state_pkey" PRIMARY KEY ("id")
);

CREATE UNIQUE INDEX "listing_media_sync_state_listing_id_key"
ON "listing_media_sync_state"("listing_id");
CREATE INDEX "listing_media_sync_state_pending_next_check_at_idx"
ON "listing_media_sync_state"("pending_next_check_at");
ALTER TABLE "listing_media_sync_state"
ADD CONSTRAINT "listing_media_sync_state_listing_id_fkey"
FOREIGN KEY ("listing_id") REFERENCES "listings"("listing_id")
ON DELETE CASCADE ON UPDATE CASCADE;
""",
)

write(
    "lib/idx/listing-media-sync-state.ts",
    r'''import prisma from "@/lib/prisma";
import type { PendingCandidateState } from "./media-reconcile-guard";

export const PENDING_VERIFICATION_LIMIT = 10;
export const PENDING_RECHECK_DELAY_MS = 10 * 60 * 1000;

export interface ListingMediaSyncSnapshot {
listingId: string;
lastSeenPhotosChangeTs: Date | null;
lastCompleteMediaSetHash: string | null;
lastReconciledAt: Date | null;
lastSourceModificationTs: Date | null;
pending: PendingCandidateState | null;
}

export interface PendingLaneRow extends ListingMediaSyncSnapshot {
pendingNextCheckAt: Date | null;
}

export interface PendingQueueStats {
count: number;
oldestFirstObservedAt: Date | null;
}

const clearPendingData = {
pending_candidate_set_hash: null,
pending_candidate_media_count: null,
pending_missing_media_count: null,
pending_photos_change_timestamp: null,
pending_source_modification_ts: null,
pending_first_observed_at: null,
pending_last_observation_run_id: null,
pending_confirmation_count: 0,
pending_next_check_at: null,
} as const;

function toSnapshot(row: {
listing_id: string;
last_seen_photos_change_ts: Date | null;
last_complete_media_set_hash: string | null;
last_reconciled_at: Date | null;
last_source_modification_ts: Date | null;
pending_candidate_set_hash: string | null;
pending_candidate_media_count: number | null;
pending_missing_media_count: number | null;
pending_photos_change_timestamp: Date | null;
pending_source_modification_ts: Date | null;
pending_first_observed_at: Date | null;
pending_last_observation_run_id: string | null;
pending_confirmation_count: number;
pending_next_check_at?: Date | null;
}): PendingLaneRow {
const hasPending = row.pending_confirmation_count > 0 && row.pending_candidate_set_hash != null;
return {
listingId: row.listing_id,
lastSeenPhotosChangeTs: row.last_seen_photos_change_ts,
lastCompleteMediaSetHash: row.last_complete_media_set_hash,
lastReconciledAt: row.last_reconciled_at,
lastSourceModificationTs: row.last_source_modification_ts,
pending: hasPending
? {
    candidateSetHash: row.pending_candidate_set_hash,
    candidateMediaCount: row.pending_candidate_media_count,
    missingMediaCount: row.pending_missing_media_count,
    photosChangeTimestamp: row.pending_photos_change_timestamp,
    sourceModificationTs: row.pending_source_modification_ts,
    firstObservedAt: row.pending_first_observed_at,
    lastObservationRunId: row.pending_last_observation_run_id,
    confirmationCount: row.pending_confirmation_count,
  }
: null,
pendingNextCheckAt: row.pending_next_check_at ?? null,
};
}

export async function mediaSyncStateTableAvailable(): Promise<boolean> {
const query = (prisma as unknown as { $queryRawUnsafe?: (sql: string) => Promise<unknown> }).$queryRawUnsafe;
if (typeof query !== "function") return false;
try {
await query.call(prisma, 'SELECT 1 FROM "listing_media_sync_state" LIMIT 1');
return true;
} catch (error) {
const message = error instanceof Error ? error.message : String(error);
if (/listing_media_sync_state/i.test(message) && /(does not exist|P2021|undefined table)/i.test(message)) {
return false;
}
throw error;
}
}

export async function getListingMediaSyncState(
listingId: string,
): Promise<ListingMediaSyncSnapshot | null> {
const row = await prisma.listingMediaSyncState.findUnique({ where: { listing_id: listingId } });
return row ? toSnapshot(row) : null;
}

export async function writePendingCandidate(args: {
listingId: string;
pending: PendingCandidateState;
nextCheckAt: Date;
}): Promise<void> {
const data = {
pending_candidate_set_hash: args.pending.candidateSetHash,
pending_candidate_media_count: args.pending.candidateMediaCount,
pending_missing_media_count: args.pending.missingMediaCount,
pending_photos_change_timestamp: args.pending.photosChangeTimestamp,
pending_source_modification_ts: args.pending.sourceModificationTs,
pending_first_observed_at: args.pending.firstObservedAt,
pending_last_observation_run_id: args.pending.lastObservationRunId,
pending_confirmation_count: args.pending.confirmationCount,
pending_next_check_at: args.nextCheckAt,
};
await prisma.listingMediaSyncState.upsert({
where: { listing_id: args.listingId },
create: { listing_id: args.listingId, ...data },
update: data,
});
}

export async function commitReconcileCheckpoint(args: {
listingId: string;
mediaSetHash: string;
photosChangeTs: Date | null;
sourceModificationTs: Date | null;
reconciledAt: Date;
}): Promise<void> {
const checkpoint = {
last_seen_photos_change_ts: args.photosChangeTs,
last_complete_media_set_hash: args.mediaSetHash,
last_reconciled_at: args.reconciledAt,
last_source_modification_ts: args.sourceModificationTs,
...clearPendingData,
};
await prisma.listingMediaSyncState.upsert({
where: { listing_id: args.listingId },
create: { listing_id: args.listingId, ...checkpoint },
update: checkpoint,
});
}

export async function clearPending(listingId: string): Promise<void> {
await prisma.listingMediaSyncState.updateMany({
where: { listing_id: listingId },
data: clearPendingData,
});
}

export async function selectPendingLane(
limit = PENDING_VERIFICATION_LIMIT,
now = new Date(),
): Promise<PendingLaneRow[]> {
const rows = await prisma.listingMediaSyncState.findMany({
where: {
pending_confirmation_count: { gt: 0 },
OR: [{ pending_next_check_at: null }, { pending_next_check_at: { lte: now } }],
},
orderBy: [{ pending_next_check_at: "asc" }, { updated_at: "asc" }],
take: Math.max(0, limit),
});
return rows.map(toSnapshot);
}

export async function getPendingQueueStats(): Promise<PendingQueueStats> {
const [count, oldest] = await Promise.all([
prisma.listingMediaSyncState.count({ where: { pending_confirmation_count: { gt: 0 } } }),
prisma.listingMediaSyncState.findFirst({
where: { pending_confirmation_count: { gt: 0 } },
orderBy: { pending_first_observed_at: "asc" },
select: { pending_first_observed_at: true },
}),
]);
return { count, oldestFirstObservedAt: oldest?.pending_first_observed_at ?? null };
}
''',
)

write(
    "lib/idx/__tests__/listing-media-sync-state.test.ts",
    r'''const mockQueryRawUnsafe = jest.fn<Promise<unknown>, [string]>();
const mockFindMany = jest.fn<Promise<unknown[]>, [unknown]>();
const mockFindUnique = jest.fn<Promise<unknown>, [unknown]>();
const mockUpsert = jest.fn<Promise<unknown>, [unknown]>();
const mockUpdateMany = jest.fn<Promise<unknown>, [unknown]>();
const mockCount = jest.fn<Promise<number>, [unknown]>();
const mockFindFirst = jest.fn<Promise<unknown>, [unknown]>();

jest.mock("@/lib/prisma", () => ({
  __esModule: true,
  default: {
    $queryRawUnsafe: (sql: string) => mockQueryRawUnsafe(sql),
    listingMediaSyncState: {
      findMany: (args: unknown) => mockFindMany(args),
      findUnique: (args: unknown) => mockFindUnique(args),
      findFirst: (args: unknown) => mockFindFirst(args),
      upsert: (args: unknown) => mockUpsert(args),
      updateMany: (args: unknown) => mockUpdateMany(args),
      count: (args: unknown) => mockCount(args),
    },
  },
}));

import { mediaSyncStateTableAvailable, selectPendingLane } from "../listing-media-sync-state";

beforeEach(() => {
  jest.clearAllMocks();
});

test("capability check fails closed when the table cannot be read", async () => {
  mockQueryRawUnsafe.mockRejectedValueOnce(new Error("relation listing_media_sync_state does not exist"));
  await expect(mediaSyncStateTableAvailable()).resolves.toBe(false);
});

test("pending lane is bounded, due-only, and deterministically ordered", async () => {
  mockFindMany.mockResolvedValueOnce([
    {
      listing_id: "L-1",
      last_seen_photos_change_ts: null,
      last_complete_media_set_hash: "v1:old",
      last_reconciled_at: null,
      last_source_modification_ts: null,
      pending_candidate_set_hash: "v1:new",
      pending_candidate_media_count: 2,
      pending_missing_media_count: 1,
      pending_photos_change_timestamp: null,
      pending_source_modification_ts: null,
      pending_first_observed_at: new Date("2026-07-26T00:00:00Z"),
      pending_last_observation_run_id: "run-1",
      pending_confirmation_count: 1,
      pending_next_check_at: null,
    },
  ]);
  const now = new Date("2026-07-26T01:00:00Z");
  const rows = await selectPendingLane(3, now);
  expect(mockFindMany).toHaveBeenCalledWith({
    where: {
      pending_confirmation_count: { gt: 0 },
      OR: [{ pending_next_check_at: null }, { pending_next_check_at: { lte: now } }],
    },
    orderBy: [{ pending_next_check_at: "asc" }, { updated_at: "asc" }],
    take: 3,
  });
  expect(rows).toHaveLength(1);
  expect(rows[0].pending?.candidateSetHash).toBe("v1:new");
});
''',
)

