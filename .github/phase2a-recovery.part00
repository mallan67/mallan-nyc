nested_code = """  emitCursorTelemetry("run_start", runId, {
started_at: new Date(now()).toISOString(),
listings_per_run: listingsPerRun,
});

const aggregateUpsert = (upsertResult: UpsertListingMediaResult): void => {
rowsInserted += upsertResult.inserted;
rowsUpdatedChanged += upsertResult.updatedChanged;
rowsSkippedUnchanged += upsertResult.skippedUnchanged;
rowsSkippedInvalid += upsertResult.skippedInvalid;
deleteSignalsReceived += upsertResult.deleteSignalsReceived;
tombstonedExplicit += upsertResult.tombstonedExplicit;
tombstonedVanished += upsertResult.tombstonedVanished;
rowsTombstoned += upsertResult.tombstoned;
rowsUpdated += upsertResult.physicalWrites;
accumulateMediaWriteCauses(causeTotals, upsertResult);
attr.existing_rows_compared += upsertResult.existingRowsCompared;
attr.mismatch_status += upsertResult.mismatchStatus;
attr.mismatch_listing_id += upsertResult.mismatchListingId;
attr.mismatch_resource_record_key += upsertResult.mismatchResourceRecordKey;
attr.mismatch_resource_record_id += upsertResult.mismatchResourceRecordId;
attr.mismatch_media_url_exact += upsertResult.mismatchMediaUrlExact;
attr.mismatch_media_url_identity += upsertResult.mismatchMediaUrlIdentity;
attr.mismatch_media_url_identity_equivalent += upsertResult.mismatchMediaUrlIdentityEquivalent;
attr.mismatch_media_type += upsertResult.mismatchMediaType;
attr.mismatch_media_category += upsertResult.mismatchMediaCategory;
attr.mismatch_media_classification += upsertResult.mismatchMediaClassification;
attr.mismatch_order += upsertResult.mismatchOrder;
attr.mismatch_preferred_photo += upsertResult.mismatchPreferredPhoto;
attr.mismatch_media_modification_ts += upsertResult.mismatchMediaModificationTs;
attr.mismatch_modification_ts += upsertResult.mismatchModificationTs;
attr.rows_with_one_mismatch += upsertResult.rowsWithOneMismatch;
attr.rows_with_multiple_mismatches += upsertResult.rowsWithMultipleMismatches;
};

const toMediaSetItem = (row: UpsertListingMediaInput): MediaSetItem => ({
mediaKey: row.MediaKey,
resourceRecordKey: row.ResourceRecordKey,
mediaUrl: row.MediaURL,
mediaType: classifyTrestleMediaCategory(row.MediaCategory),
mediaCategory: row.MediaCategory,
mediaClassification: row.MediaClassification,
order: row.Order == null ? null : Number(row.Order),
preferredPhotoYN: parseBool(row.PreferredPhotoYN),
mediaModificationTs: row.MediaModificationTimestamp,
modificationTs: row.ModificationTimestamp,
});

const processMediaSet = async (args: {
listingId: string;
listingKey: string;
photosChangeTs: Date | string | null;
sourceModificationTs: Date | string | null;
mediaRows: UpsertListingMediaInput[];
}): Promise<{ ok: boolean; action: ReconcileAction | "legacy" }> => {
rowsChecked += args.mediaRows.length;
const runUpsert = async (tombstoneVanished: boolean): Promise<UpsertListingMediaResult> => {
const result = await upsertListingMedia(args.listingId, args.mediaRows, {
photosChangeTsSnapshot: args.photosChangeTs,
tombstoneVanished,
});
aggregateUpsert(result);
if (result.writeFailures > 0) throw new Error("listing_media_write_incomplete");
return result;
};

if (!reconcileStateAvailable) {
await runUpsert(true);
try {
await updateListingMediaSummary(args.listingId, { counters: summaryWrites, revalidation });
} catch (summaryErr) {
summaryWrites.rows_failed++;
throw summaryErr;
}
return { ok: true, action: "legacy" };
}

const previousRows = await prisma.listingMedia.findMany({
where: { listing_id: args.listingId, status: "active" },
select: { media_key: true },
});
const previousActiveFeedKeys = previousRows
.map((row) => row.media_key)
.filter((key): key is string => typeof key === "string" && !key.startsWith(CRM_MEDIA_KEY_PREFIX));
const activeCandidateRows = args.mediaRows.filter((row) => row.MediaStatus !== "Deleted");
const sourceContractUnsafe = activeCandidateRows.some(
(row) =>
  (row.Permission != null && String(row.Permission) !== "Public") ||
  (row.ResourceName != null && String(row.ResourceName) !== "Property"),
);
if (sourceContractUnsafe) {
sourceSetsInvalid++;
return { ok: false, action: "unsafe_retry" };
}
const hashResult = stableMediaSetHash(activeCandidateRows.map(toMediaSetItem), args.listingKey);
const explicitDeleteKeys = args.mediaRows
.filter((row) => row.MediaStatus === "Deleted" && row.MediaKey != null)
.map((row) => String(row.MediaKey));
const candidateFeedKeys = Array.from(
new Set([
...activeCandidateRows.map((row) => (row.MediaKey == null ? "" : String(row.MediaKey))).filter(Boolean),
...explicitDeleteKeys,
]),
);
const state = await getListingMediaSyncState(args.listingId);
const decision = decideReconcile({
listingKey: args.listingKey,
cycleRunId: reconcileCycleId,
hashResult,
previousActiveFeedKeys,
candidateFeedKeys,
pending: state?.pending ?? null,
observedPct: parseDate(args.photosChangeTs),
observedSourceModTs: parseDate(args.sourceModificationTs),
lastCheckpointHash: state?.lastCompleteMediaSetHash ?? null,
now: new Date(now()),
});

if (decision.action === "unsafe_retry") {
sourceSetsInvalid++;
return { ok: false, action: decision.action };
}

await runUpsert(decision.tombstoneVanishedFeed);

if (decision.action === "record_pending") {
if (!decision.pendingWrite) throw new Error("pending_decision_missing_state");
await writePendingCandidate({
listingId: args.listingId,
pending: decision.pendingWrite,
nextCheckAt: new Date(now() + PENDING_RECHECK_DELAY_MS),
});
pendingVerificationsRecorded++;
return { ok: true, action: decision.action };
}

if (decision.action === "no_op") {
await clearPending(args.listingId);
listingPayloadsSuppressed++;
return { ok: true, action: decision.action };
}

if (decision.updateSummary) {
try {
await updateListingMediaSummary(args.listingId, { counters: summaryWrites, revalidation });
} catch (summaryErr) {
summaryWrites.rows_failed++;
throw summaryErr;
}
} else {
listingPayloadsSuppressed++;
}

if (!decision.advanceCheckpoint || !decision.checkpointHash) {
throw new Error("reconcile_decision_missing_checkpoint");
}
await commitReconcileCheckpoint({
listingId: args.listingId,
mediaSetHash: decision.checkpointHash,
photosChangeTs: parseDate(args.photosChangeTs),
sourceModificationTs: parseDate(args.sourceModificationTs),
reconciledAt: new Date(now()),
});
if (decision.action === "confirm_removal") implicitDisappearancesConfirmed++;
return { ok: true, action: decision.action };
};

// ── PHASE 1: source ingest ───────────────────────────────────────────
"""
sub_once(
    "lib/idx/media-sync.ts",
    r'  emitCursorTelemetry\("run_start", runId, \{\n    started_at: new Date\(now\(\)\)\.toISOString\(\),\n    listings_per_run: listingsPerRun,\n  \}\);\n\n  // ── PHASE 1: source ingest ─+',
    nested_code.rstrip(),
)

