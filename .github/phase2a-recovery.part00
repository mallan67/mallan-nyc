from pathlib import Path
import subprocess
import sys
import traceback

ORIGINAL_PART00_BLOB = "ca854993916797ec4cbedfbd9bdad7cd495e1e85"
BRANCH = "fix/neon-write-amp-phase2a-media-reconcile-2026-07-26"
ERROR_PATH = Path(".github/phase2a-recovery.error.log")


def run(cmd, **kwargs):
    return subprocess.run(cmd, text=True, **kwargs)


def persist_failure(message: str) -> None:
    head = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
    diagnostic = (
        "Phase 2A recovery failed before validation.\n"
        f"branch={BRANCH}\n"
        f"head={head}\n\n"
        "--- exact failure ---\n"
        + message
    )
    ERROR_PATH.write_text(diagnostic)
    print(diagnostic)
    run(["git", "config", "user.name", "github-actions[bot]"], check=True)
    run(
        [
            "git",
            "config",
            "user.email",
            "41898282+github-actions[bot]@users.noreply.github.com",
        ],
        check=True,
    )
    run(["git", "add", str(ERROR_PATH)], check=True)
    run(["git", "commit", "-m", "chore: capture Phase 2A recovery failure"], check=True)
    run(["git", "push", "origin", f"HEAD:{BRANCH}"], check=True)


try:
    original = subprocess.check_output(
        ["git", "cat-file", "blob", ORIGINAL_PART00_BLOB], text=True
    )
    continuation = Path(".github/phase2a-recovery.part01").read_text()
    exec(compile(original + continuation, "/tmp/phase2a-recovery-original.py", "exec"), {})
except BaseException:
    persist_failure(traceback.format_exc())
    raise SystemExit(1)

# The original implementation removes the recovery workflow and payload files.
# Stop here so the continuation appended by the workflow's `cat` command is not
# executed a second time.
raise SystemExit(0)
