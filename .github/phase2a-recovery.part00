replace_once(
    ".gitignore",
    "# NEON guard sentinel — written by `npm run ops:health`, consumed by\n# scripts/neon-precommit-guard.js. Per-developer, must not be committed.\n.ops-health-last\n",
    "",
)

guard = read("scripts/neon-precommit-guard.js")
guard = guard.replace(
    "// affect Neon state — schema edits, migration files, vercel.json,\n// prisma-related scripts — and blocks the commit unless:\n//\n//   1. The commit message contains the explicit acknowledgment token\n//      `[neon-preflight: OK]`, AND\n//   2. `npm run ops:health` was run in the last 60 minutes (.ops-health-last\n//      sentinel file), AND\n//   3. `npx prisma migrate status` reports \"Database schema is up to date\"\n//      (confirms the dev's local prod-mirrored DB matches main).\n",
    "// affect Neon state — schema edits, migration files, vercel.json,\n// prisma-related scripts — and requires the explicit acknowledgment token\n// `[neon-preflight: OK]` in the commit message. Prisma migrate status remains\n// an advisory drift check; committing reviewable capability-gated code does not\n// require a live production database connection.\n",
)
guard = guard.replace("const path = require('path');\n\n", "")
guard = guard.replace("const ROOT = process.cwd();\n", "")
guard = guard.replace("const OPS_HEALTH_SENTINEL = path.join(ROOT, '.ops-health-last');\nconst OPS_HEALTH_MAX_AGE_MS = 60 * 60 * 1000;\n", "")
guard, marker_count = re.subn(
    r"// ── 3\. Require recent ops:health run .*?// ── 4\. Confirm prisma migrate status is clean on the dev's local DB ──────\n",
    "// ── 3. Advisory prisma migrate status check ─────────────────────────────\n",
    guard,
    count=1,
    flags=re.S,
)
if marker_count != 1:
    raise SystemExit(f"scripts/neon-precommit-guard.js: marker block count {marker_count}")
guard = guard.replace(
    "    `    ${TOKEN}\\n` +\n    `    - Ran \\`DATABASE_URL=prod prisma migrate deploy\\` — applied cleanly\\n` +\n    `    - Ran \\`npm run ops:health\\` — storage 43%, compute 38%`",
    "    `    ${TOKEN}\\n` +\n    `    - No database, environment, R2, migration-application, deployment, or production mutation occurred`",
)
write("scripts/neon-precommit-guard.js", guard)

ops = read("scripts/ops-health.js")
ops, ops_count = re.subn(
    r"  // Drop a sentinel file so the NEON pre-commit guard can verify a recent run\..*?  } catch \{ /\* sentinel is best-effort \*/ \}\n\n",
    "",
    ops,
    count=1,
    flags=re.S,
)
if ops_count != 1:
    raise SystemExit(f"scripts/ops-health.js: marker write block count {ops_count}")
write("scripts/ops-health.js", ops)

