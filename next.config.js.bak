const isProd = process.env.NODE_ENV === 'production';
const apiBase = process.env.NEXT_PUBLIC_API_URL || "http://api:8000";

module.exports = {
  async rewrites() {
    // Only rewrite /api in production — in dev we want pages/api/[...proxy].js to handle /api/*
    if (!isProd) {
      return [];
    }
    return [
      {
        source: "/api/:path*",
        destination: `${apiBase}/:path*`,
      },
    ];
  },
};
